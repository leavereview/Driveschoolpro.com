# Google Ads — fill in after creating your Google Ads account (Tools & Settings → Measurement → Conversions)
# Both vars are optional — all tracking code gracefully no-ops when empty
PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXXXXXXXXXX

# Same browser key as the app's NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. Do NOT add
# HTTP-referrer restrictions to it until the app has its own server-side
# GOOGLE_MAPS_API_KEY in Vercel (the app's server-side Place Details uses this key
# today). Places API (New) must be enabled.
# Empty = the capture field degrades to a plain text input.
PUBLIC_GOOGLE_MAPS_API_KEY=
# Where the capture form submits. Override for local/preview testing only.
PUBLIC_APP_SIGNUP_URL=https://app.driveschoolpro.com/signup
