---
interface Props {
  date: string;
  updatedDate?: string;
}
const { date, updatedDate } = Astro.props;
const formatDate = (d: string) => new Date(d).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
const formattedDate = formatDate(date);
const formattedUpdated = updatedDate && updatedDate !== date ? formatDate(updatedDate) : null;
---

<div class="mt-4">
  <div class="flex items-center gap-2 text-white font-semibold">
    <a href="/about/" class="hover:underline">DriveSchoolPro Team</a>
  </div>
  <div class="flex items-center gap-3 text-sm text-gray-300 mt-0.5">
    {formattedUpdated ? (
      <span>Updated <time datetime={updatedDate}>{formattedUpdated}</time></span>
    ) : (
      <time datetime={date}>{formattedDate}</time>
    )}
  </div>
</div>
