---
/**
 * Competitor comparison page — shared by /compare/total-drive/ and
 * /compare/my-drive-time/ so the two pages cannot drift apart in structure.
 *
 * Comparative-advertising rules this page is written to (ASA CAP 3.33–3.41):
 *  - No competitor price is stated. We link to the vendor's own pricing page.
 *  - A competitor cell says "Not listed" (never "No") unless we have seen the
 *    vendor say they lack it. "Not listed" = we could not find it on their
 *    public site on `checkedOn`; the feature may exist.
 *  - Every DriveSchoolPro ✓ must be live today. Upcoming items say "Coming soon".
 *  - Tone is matter-of-fact. No comment on the vendor's motives or ownership.
 */
import { OFFER } from '../../config/offer';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../seo/FeaturedAnswer.astro';
import ComparisonTable from '../seo/ComparisonTable.astro';
import FAQEnhanced from '../seo/FAQEnhanced.astro';

interface Item { title: string; body: string }

interface Props {
  competitor: { name: string; slug: string; pricingUrl: string };
  seo: {
    title: string;
    description: string;
    schemaDescription: string;
    datePublished: string;
    dateModified: string;
  };
  checkedOn: string;
  heroIntro: string;
  featuredAnswer: string;
  intro: string;
  rows: { label: string; values: (string | boolean)[] }[];
  switchHeading: string;
  switchIntro: string;
  switchItems: Item[];
  gapsHeading: string;
  gapsBody: string;
  sources: { label: string; url: string }[];
  faqs: { question: string; answer: string; links?: { text: string; url: string }[] }[];
  faqTitle: string;
}

const {
  competitor, seo, checkedOn, heroIntro, featuredAnswer, intro, rows,
  switchHeading, switchIntro, switchItems, gapsHeading, gapsBody, sources, faqs, faqTitle,
} = Astro.props;

const pageUrl = `https://driveschoolpro.com/compare/${competitor.slug}/`;

const schemaMarkup = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `DriveSchoolPro vs ${competitor.name}: Honest Comparison for UK ADIs`,
  description: seo.schemaDescription,
  author: { '@type': 'Organization', name: 'DriveSchoolPro' },
  publisher: { '@type': 'Organization', name: 'DriveSchoolPro' },
  datePublished: seo.datePublished,
  dateModified: seo.dateModified,
};
---

<BaseLayout title={seo.title} description={seo.description} image="/images/marketing/dashboard-overview.webp">
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

  <BreadcrumbsEnhanced
    site="driveschool"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Compare', href: '/compare/' },
      { label: `vs ${competitor.name}`, href: `/compare/${competitor.slug}/` },
    ]}
  />

  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="container-custom relative">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1 bg-brand-red/20 text-brand-red-light rounded-full text-sm font-medium mb-4">Platform Comparison</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">DriveSchoolPro vs {competitor.name}</h1>
        <p class="text-xl text-gray-300 mb-8">{heroIntro}</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={OFFER.ctaPrimary.href} class="btn-primary text-lg px-8 py-4">{OFFER.ctaPrimary.label}</a>
          <a href="#comparison" class="btn-secondary text-lg px-8 py-4">See the feature table</a>
        </div>
      </div>
    </div>
  </section>

  <FeaturedAnswer question={`How does DriveSchoolPro compare to ${competitor.name}?`}>
    {featuredAnswer}
  </FeaturedAnswer>

  <section class="section bg-white">
    <div class="container-custom max-w-3xl mx-auto">
      <p class="text-lg text-gray-600 leading-relaxed mb-8">{intro}</p>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border-2 border-brand-red p-5">
          <div class="font-bold text-brand-navy mb-1">DriveSchoolPro</div>
          <p class="text-sm text-gray-600">
            {OFFER.short} while in early access, with no subscription fee and no card needed to start.
            Card payments taken through DriveSchoolPro carry a 3% platform fee plus Stripe's own processing fee.
          </p>
        </div>
        <div class="rounded-xl border-2 border-gray-200 p-5">
          <div class="font-bold text-gray-700 mb-1">{competitor.name}</div>
          <p class="text-sm text-gray-600">
            Prices change, so we don't quote them here.
            <a href={competitor.pricingUrl} class="text-brand-red font-semibold hover:underline" rel="noopener" target="_blank">See {competitor.name}'s current pricing &rarr;</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="comparison" class="bg-gray-50">
    <ComparisonTable
      title="Feature comparison"
      description={`Features only, no pricing. ${competitor.name} entries reflect what their public website lists, checked ${checkedOn}.`}
      headers={['DriveSchoolPro', competitor.name]}
      rows={rows}
      rowHeader="Feature"
      highlightColumn={0}
    />
    <div class="container-custom pb-12">
      <p class="max-w-5xl mx-auto text-sm text-gray-500">
        <strong>"Not listed"</strong> means we could not find the feature on {competitor.name}'s public website on {checkedOn}.
        It may exist. We use "Not listed" rather than "No" so we never say a competitor lacks something we haven't seen them say.
        If anything here is out of date, email <a href="mailto:info@driveschoolpro.com" class="text-brand-red hover:underline">info@driveschoolpro.com</a> and we'll correct it.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-custom max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-4">{switchHeading}</h2>
      <p class="text-gray-600 mb-6 leading-relaxed">{switchIntro}</p>
      <ul class="space-y-4">
        {switchItems.map(({ title, body }) => (
          <li class="flex items-start gap-4">
            <div class="w-6 h-6 rounded-full bg-brand-red-light flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-3 h-3 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <div class="font-semibold text-gray-900 mb-1">{title}</div>
              <div class="text-gray-600 text-sm">{body}</div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-gray-50">
    <div class="container-custom max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-4">{gapsHeading}</h2>
      <p class="text-gray-600 leading-relaxed">{gapsBody}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-custom max-w-3xl mx-auto">
      <h2 class="text-xl font-bold text-brand-navy mb-3">Where this information comes from</h2>
      <ul class="space-y-1 text-sm">
        {sources.map(({ label, url }) => (
          <li><a href={url} class="text-brand-red hover:underline" rel="noopener" target="_blank">{label}</a></li>
        ))}
      </ul>
      <p class="text-sm text-gray-500 mt-3">Checked {checkedOn}. Compare more platforms on our <a href="/compare/" class="text-brand-red hover:underline">comparison hub</a>.</p>
    </div>
  </section>

  <section class="section bg-brand-navy text-white text-center">
    <div class="container-custom">
      <h2 class="text-3xl font-bold mb-3">Try DriveSchoolPro — {OFFER.short}</h2>
      <p class="text-white/80 text-lg mb-8 max-w-xl mx-auto">No credit card. Keep your current diary running alongside until you're confident everything's in.</p>
      <a href={OFFER.ctaPrimary.href} class="inline-block bg-brand-red text-white px-10 py-4 rounded-xl font-semibold text-lg hover:bg-red-700 transition-colors">
        {OFFER.ctaPrimary.label} &rarr;
      </a>
      <p class="text-white/50 text-sm mt-3">{OFFER.short} &middot; No credit card required &middot; Cancel anytime</p>
    </div>
  </section>

  <FAQEnhanced faqs={faqs} title={faqTitle} site="driveschool" pageUrl={pageUrl} />
</BaseLayout>
