---
// Real customer quotes, verbatim from Trustpilot (https://uk.trustpilot.com/review/driveschoolpro.com).
// Rules: keep text exactly as published, keep name + date + Trustpilot attribution, link to the profile,
// do NOT show the overall TrustScore (not allowed without a paid Trustpilot plan). Per-review stars are each
// reviewer's own rating: every quote here is a 5-star review; if you add a non-5-star quote, add a stars field.
// Re-check quotes still exist on Trustpilot before each deploy; reviewers can edit or delete them.
interface Props {
  heading?: string;
  bg?: string;
  limit?: number;
}
const { heading = 'What instructors say about DriveSchoolPro', bg = 'bg-gray-50', limit = 3 } = Astro.props;

const PROFILE = 'https://uk.trustpilot.com/review/driveschoolpro.com';
const quotes = [
  {
    quote: "This software is really helping me focus on delivering great training, rather than running a diary and finances.",
    name: "Spencer",
    date: "19 November 2026"
  },
  {
    quote: "It is easy to use, can be customized for any sized business, and the support is amazing.",
    name: "James Sandbrook",
    date: "1 November 2026"
  },
  {
    quote: "The AI briefing is what really sets it apart from everything else.",
    name: "Alex",
    date: "2 November 2026"
  },
  {
    quote: "The DVSA competency tracking is the standout feature \u2014 I can record progress against all 27 skills after every lesson and my students can actually see where they're at.",
    name: "Richard Smith",
    date: "10 April 2026"
  }
].slice(0, limit);
---

<section class={`py-16 md:py-20 ${bg}`} id="reviews">
  <div class="container-custom">
    <div class="text-center mb-10">
      <span class="text-brand-red font-semibold text-sm uppercase tracking-wider">Reviews</span>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mt-2">{heading}</h2>
    </div>
    <div class={`grid grid-cols-1 gap-6 ${quotes.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2'}`}>
      {quotes.map((q) => (
        <figure class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex flex-col">
          <div class="flex gap-0.5 mb-3" role="img" aria-label="5 out of 5 stars, this reviewer's Trustpilot rating">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <blockquote class="text-gray-700 leading-relaxed mb-5 flex-1">&ldquo;{q.quote}&rdquo;</blockquote>
          <figcaption class="text-sm text-gray-500">
            <span class="font-semibold text-gray-900">{q.name}</span>
            <span> &middot; Trustpilot review, {q.date}</span>
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="text-center mt-8">
      <a href={PROFILE} target="_blank" rel="noopener noreferrer" class="text-brand-red font-semibold hover:underline">
        Read all our reviews on Trustpilot &rarr;
      </a>
    </p>
  </div>
</section>
