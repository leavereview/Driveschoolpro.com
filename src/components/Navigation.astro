---
import { OFFER } from '../config/offer';
const currentPath = Astro.url.pathname;

// Every link lives in the menu panel — the bar itself only carries the logo,
// Log in and the primary CTA (Shopify-style). Sections drive the panel columns.
const menuSections = [
  {
    title: 'Features',
    href: '/features/',
    groups: [
      [
        { label: 'All features', href: '/features/' },
        { label: 'Scheduling', href: '/features/scheduling/' },
        { label: 'AI lesson briefings', href: '/features/lesson-briefings/' },
      ],
      [
        { label: 'DVSA progress tracking', href: '/features/progress-tracking/' },
        { label: 'Getting paid', href: '/features/getting-paid/' },
        { label: 'Review collection', href: '/features/reviews/' },
      ],
    ],
  },
  {
    title: 'Software',
    href: '/driving-school-software/',
    groups: [
      [
        { label: 'Driving School Software', href: '/driving-school-software/' },
        { label: 'Scheduling Software', href: '/driving-school-scheduling-software/' },
        { label: 'Management Software', href: '/driving-school-management-software/' },
        { label: 'Free Software', href: '/free-driving-school-software/' },
      ],
      [
        { label: 'Revenue Calculator', href: '/driving-school-calculator/' },
        { label: 'Cost of Learning Calculator', href: '/tools/cost-calculator/' },
      ],
    ],
  },
  {
    title: 'Driving Skills',
    href: '/dvsa-27-driving-skills/',
    groups: [
      [
        { label: '27 Driving Skills Guide', href: '/dvsa-27-driving-skills/' },
      ],
      [
        { label: 'The Basics (Skills 1–4)', href: '/driving-skills/basics/' },
        { label: 'Control & Positioning (5–7)', href: '/driving-skills/control-positioning/' },
        { label: 'Observation & Planning (8–13)', href: '/driving-skills/observation-signalling/' },
        { label: 'Junctions & Roundabouts (14–16)', href: '/driving-skills/junctions-roundabouts/' },
        { label: 'Manoeuvres (17–20)', href: '/driving-skills/manoeuvres/' },
        { label: 'Road Types (21–23)', href: '/driving-skills/road-types/' },
        { label: 'Driving Conditions (24–26)', href: '/driving-skills/driving-conditions/' },
        { label: 'Following Routes (Skill 27)', href: '/driving-skills/following-routes/' },
      ],
    ],
  },
  {
    title: 'Company',
    href: '/about/',
    groups: [
      [
        { label: 'Home', href: '/' },
        { label: 'Pricing', href: '/pricing/' },
        { label: 'Blog', href: '/blog/' },
        { label: 'About', href: '/about/' },
        { label: 'Contact', href: '/contact/' },
      ],
    ],
  },
];

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100">
  <div class="container-custom">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center gap-2 group">
        <span class="text-2xl font-bold text-brand-navy">DriveSchool<span class="text-brand-red">Pro</span></span>
      </a>

      <div class="flex items-center gap-2 md:gap-4">
        <a
          href="https://app.driveschoolpro.com/login"
          class="hidden sm:inline-block text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors"
        >
          Log in
        </a>
        <a href={OFFER.ctaPrimary.href} class="hidden sm:inline-block btn-primary text-sm">
          {OFFER.ctaPrimary.labelShort}
        </a>

        <button
          type="button"
          class="p-2 rounded-lg text-gray-700 hover:bg-gray-100 min-w-[44px] min-h-[44px] flex items-center justify-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red focus-visible:ring-offset-2"
          id="nav-menu-btn"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <svg class="w-6 h-6" id="nav-menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 hidden" id="nav-menu-icon-close" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="hidden" id="nav-menu">
    <div class="bg-white border-t border-gray-100 shadow-lg overflow-y-auto overscroll-contain max-h-[calc(100dvh-4rem)] md:max-h-[calc(100dvh-5rem)]">
      <div class="container-custom py-6 md:py-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
          {menuSections.map((section) => (
            <div>
              <a
                href={section.href}
                class:list={[
                  'block text-xs font-semibold uppercase tracking-wider mb-3 transition-colors',
                  isActive(section.href) ? 'text-brand-red' : 'text-gray-400 hover:text-gray-600'
                ]}
              >
                {section.title}
              </a>
              {section.groups.map((group, groupIndex) => (
                <div class:list={[groupIndex > 0 && 'mt-3 pt-3 border-t border-gray-100']}>
                  {group.map((item) => (
                    <a
                      href={item.href}
                      class:list={[
                        'block px-3 py-2 -mx-3 rounded-lg text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red',
                        isActive(item.href)
                          ? 'text-brand-red bg-brand-red-light'
                          : 'text-gray-600 hover:text-brand-red hover:bg-gray-50'
                      ]}
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </div>

        <div class="mt-8 pt-6 border-t border-gray-100 flex flex-col sm:hidden gap-2">
          <a href={OFFER.ctaPrimary.href} class="btn-primary w-full text-center">
            {OFFER.ctaPrimary.labelShort}
          </a>
          <a href="https://app.driveschoolpro.com/login" class="btn-secondary w-full text-center">
            Log in
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<div class="fixed inset-0 z-40 bg-brand-navy/30 hidden" id="nav-menu-backdrop"></div>

<script>
  const menuBtn = document.getElementById('nav-menu-btn');
  const menu = document.getElementById('nav-menu');
  const backdrop = document.getElementById('nav-menu-backdrop');
  const iconOpen = document.getElementById('nav-menu-icon-open');
  const iconClose = document.getElementById('nav-menu-icon-close');

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    menu?.classList.remove('hidden');
    backdrop?.classList.remove('hidden');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    menuBtn?.setAttribute('aria-expanded', 'true');
    menuBtn?.setAttribute('aria-label', 'Close menu');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    isOpen = false;
    menu?.classList.add('hidden');
    backdrop?.classList.add('hidden');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    menuBtn?.setAttribute('aria-expanded', 'false');
    menuBtn?.setAttribute('aria-label', 'Open menu');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', () => {
    if (isOpen) closeMenu();
    else openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeMenu();
      (menuBtn as HTMLElement)?.focus();
    }
  });
</script>
