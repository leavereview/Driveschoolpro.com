---
// src/components/start/StartPage.astro — one /start squeeze-page variant.
// Sells the instructor's week, not the signup steps: hero → (demos) → your week →
// on your phone and theirs → FAQ → form. Copy: src/config/start-variants.ts + moments.ts.
// No outbound links except the layout footer's Privacy/Terms: every exit costs a signup.
import BusinessNameCapture from '../BusinessNameCapture.astro';
import ArcadeDemo from '../ArcadeDemo.astro';
import WeekMoments from '../marketing/WeekMoments.astro';
import OnYourPhone from '../marketing/OnYourPhone.astro';
import { OFFER } from '../../config/offer';
import { SHARED_FAQ, fillOffer, type StartVariant } from '../../config/start-variants';

interface Props {
  variant: StartVariant;
}
const { variant } = Astro.props;
const fill = (s: string) => fillOffer(s, OFFER);
const faqs = [...SHARED_FAQ, variant.extraFaq];
const captureLabel = 'Your driving school (or your own name)';
const captureNote = 'No card needed · Nothing charged automatically';
---
<div data-start-variant={variant.id}>
  <!-- Brand bar: confirms the advertiser named in the ad. Deliberately not a link — squeeze page, no exits. -->
  <header class="border-b border-gray-100 bg-white">
    <div class="container-custom flex h-11 md:h-16 items-center justify-between">
      <span class="text-lg md:text-2xl font-bold text-brand-navy">DriveSchool<span class="text-brand-red">Pro</span></span>
      <span class="text-xs md:text-sm font-medium text-gray-500">Free during early access</span>
    </div>
  </header>

  <section class="bg-white pt-4 pb-10 md:py-16">
    <div class="container-custom max-w-5xl md:grid md:grid-cols-[1fr_auto] md:items-center md:gap-16">
      <div class="text-center md:text-left">
        <h1 class="text-[1.75rem] leading-tight md:text-5xl font-bold text-brand-navy mb-2 md:mb-4">{variant.h1}</h1>
        <p class="text-base md:text-lg text-gray-600 mb-5 md:mb-8">{fill(variant.subhead)}</p>
        <div class="flex justify-center md:justify-start text-left">
          <BusinessNameCapture id="start-capture-top" label={captureLabel} cta={variant.cta} note={captureNote} autofocus />
        </div>
      </div>
      <img
        src={variant.hero.src}
        alt={variant.hero.alt}
        width={variant.hero.width}
        height={variant.hero.height}
        loading="eager"
        decoding="async"
        class="hidden md:block w-72 aspect-[9/16] object-cover object-top rounded-3xl border border-gray-200 shadow-xl"
      />
    </div>
  </section>

  {variant.arcade && (
    <section id="see-it-working" class="bg-gray-50 py-10 md:py-16" aria-labelledby="start-demo">
      <div class="container-custom max-w-4xl">
        <h2 id="start-demo" class="text-2xl font-bold text-brand-navy text-center mb-2">Click through it yourself</h2>
        <p class="text-center text-gray-600 mb-8">The real app with sample pupils — nothing to sign up for.</p>
        <div class="space-y-10">
          {variant.arcade.map((d) => (
            <figure>
              <ArcadeDemo id={d.id} title={d.title} ratio={d.ratio} mobile="inline" />
              <figcaption class="mt-3 text-center text-sm text-gray-500">{d.title}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {variant.appsFirst && <OnYourPhone />}
  <WeekMoments moments={variant.moments} />
  {!variant.appsFirst && <OnYourPhone />}

  <section class:list={[variant.appsFirst ? 'bg-gray-50' : 'bg-white', 'py-10 md:py-16']} aria-labelledby="start-faq">
    <div class="container-custom max-w-2xl">
      <h2 id="start-faq" class="text-2xl font-bold text-brand-navy text-center mb-6">Questions</h2>
      <div class="divide-y divide-gray-100 border-y border-gray-100">
        {faqs.map((f) => (
          <details class="group">
            <summary class="flex min-h-[44px] cursor-pointer items-center justify-between py-3 font-medium text-brand-navy">
              {fill(f.q)}
              <span aria-hidden="true" class="ml-4 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="pb-4 text-sm text-gray-600">{fill(f.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-navy py-12 md:py-16">
    <div class="container-custom max-w-2xl text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Set up takes about two minutes</h2>
      <p class="text-gray-300 mb-6">Then add your pupils and you’re running. {OFFER.short} — no card required.</p>
      <div class="flex justify-center text-left">
        <BusinessNameCapture id="start-capture-bottom" tone="dark" label={captureLabel} cta={variant.cta} note={captureNote} />
      </div>
    </div>
  </section>

  <!-- Phones only: appears once the top field has scrolled away, hides while either field is on screen. -->
  <div
    data-sticky-cta
    hidden
    class="fixed inset-x-0 bottom-0 z-40 border-t border-gray-200 bg-white/95 px-4 py-3 backdrop-blur md:hidden"
  >
    <button type="button" class="btn-primary w-full min-h-[48px] text-base">{variant.cta} →</button>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const top = document.getElementById('start-capture-top-org');
  const forms = [...document.querySelectorAll<HTMLFormElement>('form[data-capture]')];
  if (bar && top && forms.length) {
    const visible = new Set<Element>();
    let pastTop = false;
    const update = () => {
      bar.hidden = !pastTop || visible.size > 0;
    };
    new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target);
        else visible.delete(e.target);
        if (e.target === forms[0]) pastTop = !e.isIntersecting && e.boundingClientRect.top < 0;
      }
      update();
    }).observe(forms[0]);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) visible.add(e.target);
        else visible.delete(e.target);
      }
      update();
    });
    forms.slice(1).forEach((f) => io.observe(f));
    bar.querySelector('button')!.addEventListener('click', () => {
      top.scrollIntoView({ behavior: 'smooth', block: 'center' });
      top.focus({ preventScroll: true });
    });
  }
</script>
