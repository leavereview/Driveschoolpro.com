---
import { OFFER } from '../config/offer';
const currentYear = new Date().getFullYear();

const footerLinks = {
  software: [
    { label: 'Driving School Software', href: '/' },
    { label: 'Scheduling Software', href: '/driving-school-scheduling-software/' },
    { label: 'Instructor Diary App', href: '/driving-instructor-diary-app/' },
    { label: 'Accounting & Invoicing', href: '/driving-instructor-accounting-software/' },
    { label: 'Management Software', href: '/driving-school-management-software/' },
    { label: 'All Features', href: '/features/' },
    { label: 'Online Booking', href: '/features/online-booking/' },
    { label: 'Pupil App', href: '/features/pupil-app/' },
    { label: 'Lesson Packages', href: '/features/lesson-packages/' },
    { label: 'Vehicle Tracking', href: '/features/vehicles/' },
  ],
  popular: [
    { label: 'Best Driving School Software', href: '/blog/best-driving-school-software/' },
    { label: 'Reduce No-Shows Guide', href: '/blog/reduce-driving-lesson-no-shows/' },
    { label: 'Student Progress Tracking', href: '/blog/student-progress-tracking/' },
    { label: 'Starting a Driving School', href: '/blog/starting-driving-school-guide/' },
    { label: 'Driving School Insurance', href: '/blog/driving-school-insurance-guide/' },
    { label: 'Free Software Options', href: '/free-driving-school-software/' },
  ],
  comparisons: [
    { label: 'vs Total Drive', href: '/compare/total-drive/' },
    { label: 'vs My Drive Time', href: '/compare/my-drive-time/' },
    { label: 'vs Driving School Office', href: '/compare/driving-school-office/' },
    { label: 'vs Passly', href: '/compare/passly/' },
    { label: 'vs LessonBuddy', href: '/compare/lessonbuddy/' },
    { label: 'vs Teachworks', href: '/compare/teachworks/' },
    { label: 'vs Reservio', href: '/compare/reservio/' },
    { label: 'vs Driving School Manager', href: '/compare/driving-school-manager/' },
    { label: 'vs GoRoadie', href: '/compare/goroadie/' },
    { label: 'vs ADI Network', href: '/compare/adi-network/' },
    { label: 'vs EasyWeek', href: '/compare/easyweek/' },
    { label: 'Total Drive vs My Drive Time', href: '/compare/total-drive-vs-mydrivetime/' },
  ],
  drivingSkills: [
    { label: '27 Driving Skills Guide', href: '/dvsa-27-driving-skills/' },
    { label: 'The Basics (Skills 1–4)', href: '/driving-skills/basics/' },
    { label: 'Control & Positioning (5–7)', href: '/driving-skills/control-positioning/' },
    { label: 'Observation & Planning (8–13)', href: '/driving-skills/observation-signalling/' },
    { label: 'Junctions & Roundabouts (14–16)', href: '/driving-skills/junctions-roundabouts/' },
    { label: 'Manoeuvres (17–20)', href: '/driving-skills/manoeuvres/' },
    { label: 'Road Types (21–23)', href: '/driving-skills/road-types/' },
    { label: 'Driving Conditions (24–26)', href: '/driving-skills/driving-conditions/' },
    { label: 'Following Routes (Skill 27)', href: '/driving-skills/following-routes/' },
  ],
  resources: [
    { label: 'Blog', href: '/blog/' },
    { label: 'Calculator', href: '/driving-school-calculator/' },
    { label: 'Pricing', href: '/pricing/' },
    { label: 'About', href: '/about/' },
    { label: 'Company facts', href: '/about/facts/' },
    { label: 'Contact', href: '/contact/' },
    { label: 'Changelog', href: '/changelog/' },
  ],
  legal: [
    { label: 'Privacy Policy', href: '/privacy-policy/' },
    { label: 'Terms of Service', href: '/terms/' },
    { label: 'WhatsApp Policy', href: '/whatsapp/' },
  ]
};
---

<footer class="bg-brand-navy text-white">
  <div class="container-custom py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 lg:gap-10">
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-6">
          <img src="/images/brand/logo-horizontal-reversed.svg" alt="DriveSchoolPro" width="241" height="36" class="h-9 w-auto" />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          <!-- Google has used this blurb as the homepage search snippet (SERP 2026-10-08), so write it as one. -->
          Driving school software for UK ADIs: online booking and payments, lesson reminders, and progress tracking on the DVSA 27 skills. {OFFER.short}, no card needed.
        </p>
        <div class="flex gap-4">
          <!-- Facebook Page id 61595513429007. -->
          <a href="https://www.facebook.com/driveschoolpro" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="DriveSchoolPro on Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.413c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.971h-1.513c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/@driveschoolpro" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="DriveSchoolPro on YouTube">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
          <a href="https://www.instagram.com/driveschoolpro/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="DriveSchoolPro on Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 1.17.054 1.805.249 2.227.415.56.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.058 1.266.07 1.646.07 4.85s-.012 3.584-.07 4.85c-.054 1.17-.249 1.805-.413 2.227-.217.562-.477.96-.896 1.382-.42.419-.819.679-1.382.896-.422.164-1.057.36-2.227.413-1.266.058-1.646.07-4.85.07s-3.584-.012-4.85-.07c-1.17-.054-1.805-.249-2.227-.413a3.71 3.71 0 0 1-1.382-.896 3.71 3.71 0 0 1-.896-1.382c-.164-.422-.36-1.057-.413-2.227-.058-1.266-.07-1.646-.07-4.85s.012-3.584.07-4.85c.054-1.17.249-1.805.413-2.227.217-.562.477-.96.896-1.381.42-.42.819-.68 1.382-.896.422-.166 1.057-.361 2.227-.415 1.266-.058 1.646-.07 4.85-.07M12 0C8.741 0 8.333.014 7.053.072 5.775.13 4.902.333 4.14.63a5.88 5.88 0 0 0-2.126 1.384A5.88 5.88 0 0 0 .63 4.14C.333 4.902.13 5.775.072 7.053.014 8.333 0 8.741 0 12s.014 3.668.072 4.948c.058 1.277.261 2.15.558 2.913a5.88 5.88 0 0 0 1.384 2.126A5.88 5.88 0 0 0 4.14 23.37c.763.297 1.636.5 2.913.558C8.333 23.986 8.741 24 12 24s3.668-.014 4.948-.072c1.277-.058 2.15-.261 2.913-.558a5.88 5.88 0 0 0 2.126-1.384 5.88 5.88 0 0 0 1.384-2.126c.297-.763.5-1.636.558-2.913.058-1.28.072-1.689.072-4.948s-.014-3.668-.072-4.948c-.058-1.277-.261-2.15-.558-2.913a5.88 5.88 0 0 0-1.384-2.126A5.88 5.88 0 0 0 19.86.63C19.098.333 18.225.13 16.948.072 15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z" />
            </svg>
          </a>
          <a href="https://www.tiktok.com/@driveschoolpro.com" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="DriveSchoolPro on TikTok">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
          </a>
          <a href="https://www.linkedin.com/company/driveschoolpro/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors" aria-label="DriveSchoolPro on LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Software</h3>
        <ul class="space-y-3">
          {footerLinks.software.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Popular Articles</h3>
        <ul class="space-y-3">
          {footerLinks.popular.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <h3 class="text-sm font-semibold uppercase tracking-wider mt-8 mb-4">Comparisons</h3>
        <ul class="space-y-3">
          {footerLinks.comparisons.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Driving Skills</h3>
        <ul class="space-y-3">
          {footerLinks.drivingSkills.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Resources</h3>
        <ul class="space-y-3">
          {footerLinks.resources.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4">Get Started</h3>
        <p class="text-gray-400 text-sm mb-4">
          Ready to streamline your driving school? {OFFER.long}.
        </p>
        <a href={OFFER.ctaPrimary.href} class="btn-primary text-sm">
          {OFFER.ctaPrimary.label}
        </a>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">
        &copy; {currentYear} DriveSchoolPro. All rights reserved.
      </p>
      <div class="flex gap-6">
        {footerLinks.legal.map((link) => (
          <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <p class="mt-6 text-gray-500 text-xs text-center md:text-left">
      DriveSchoolPro is a product of JOHN POWELL LTD, registered in England and Wales, company number 05408918.
    </p>
  </div>
</footer>
