---
/**
 * An interactive Arcade demo (demo.arcade.software) embedded as an iframe.
 *
 * Unlike ProductDemo.astro this is a click-through the visitor drives, not a
 * silent looping clip. The wrapper uses Arcade's own aspect-ratio recipe
 * (padding-bottom % + a fixed 41px for their toolbar) so the iframe never
 * causes layout shift, and loading="lazy" keeps it off the critical path.
 *
 * Like the clips, this cannot be checked by verify-claims: confirm by eye that
 * nothing in the recorded flow shows a flag-hidden feature (src/config/features.ts).
 */
interface Props {
  /** The Arcade demo id — the path segment in demo.arcade.software/{id}. */
  id: string;
  /** Accessible name for the iframe; should say what the demo shows. */
  title: string;
  /** Arcade's padding-bottom % for this demo's aspect ratio (from its embed code). */
  ratio?: number;
  /** How the demo behaves on mobile: open in a new tab (default) or play inline. */
  mobile?: 'tab' | 'inline';
}

const { id, title, ratio = 73.6811, mobile = 'tab' } = Astro.props;
const src = `https://demo.arcade.software/${id}?embed&embed_mobile=${mobile}&embed_desktop=inline&show_copy_link=true`;
---

<div class="relative w-full h-0 rounded-xl shadow-lg border border-gray-200 overflow-hidden" style={`padding-bottom: calc(${ratio}% + 41px);`}>
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allowfullscreen
    allow="clipboard-write; autoplay"
    class="absolute top-0 left-0 w-full h-full border-0"
    style="color-scheme: light;"
  ></iframe>
</div>
