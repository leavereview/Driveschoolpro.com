---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { OFFER, PROMO } from '../config/offer';

// Early-access offer schema — DriveSchoolPro is free until 31 March 2027
const offerSchemas = [
  {
    "@context": "https://schema.org",
    "@type": "Offer",
    "@id": "https://driveschoolpro.com/pricing/#early-access",
    "name": "Early Access — Free until 31 March 2027",
    "description": "DriveSchoolPro is free during early access — until 31 March 2027. Unlimited pupils and lessons, scheduling, online booking, DVSA progress tracking, invoicing, and multi-instructor features. No card required, no setup fees.",
    "price": "0",
    "priceCurrency": "GBP",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "0",
      "priceCurrency": "GBP",
      "unitText": "month",
      "billingIncrement": 1
    },
    "priceValidUntil": "2027-03-31",
    "availability": "https://schema.org/InStock",
    "url": OFFER.ctaPrimary.href,
    "seller": {
      "@type": "Organization",
      "name": "DriveSchoolPro"
    },
    "itemOffered": {
      "@id": "https://driveschoolpro.com/#software"
    },
    "additionalProperty": [
      {
        "@type": "PropertyValue",
        "name": "Credit Card Required",
        "value": "No"
      },
      {
        "@type": "PropertyValue",
        "name": "Setup Fee",
        "value": "No"
      }
    ]
  }
];

// FAQ schema for pricing page — keep in sync with the visible FAQ section below
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://driveschoolpro.com/pricing/#faqpage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is DriveSchoolPro really free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — DriveSchoolPro is free until 31 March 2027 while we're in early access. No card is required and nothing is ever charged automatically. We charge 3% on card payments your school collects through DriveSchoolPro; Stripe's own processing fee is separate. Pricing will be announced well before 1 April 2027."
      }
    },
    {
      "@type": "Question",
      "name": "How much does driving school software cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Driving school software in the UK typically costs £15–£100+ per month. DriveSchoolPro is currently free — until 31 March 2027 — because we're in early access and building the product with founding schools. That includes unlimited pupils and lessons, scheduling, online booking, DVSA progress tracking, invoicing, and multi-instructor features."
      }
    },
    {
      "@type": "Question",
      "name": "What happens after 31 March 2027?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We'll announce pricing well before 1 April 2027, so you'll have plenty of time to decide. Because there's no card on file, nothing is ever charged automatically — you'll only pay if you actively choose a plan when pricing launches."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a contract?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. There's no contract, no card on file, and no cancellation fees. You can stop using DriveSchoolPro at any time."
      }
    },
    {
      "@type": "Question",
      "name": "How do my pupils pay me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can record cash, bank transfer, and cheque payments, and take card payments through Stripe pay-links on invoices. We charge 3% on card payments you collect through DriveSchoolPro, and Stripe's standard processing fee applies on top."
      }
    },
    {
      "@type": "Question",
      "name": "How is my data kept secure, and where is it hosted?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "DriveSchoolPro is run by LEAVE.REVIEW LTD, a UK company and the data controller under UK GDPR. Payments are handled by Stripe (PCI DSS Level 1) and your data is encrypted at rest. Our sub-processors are Stripe, Neon, Vercel and Resend."
      }
    },
    {
      "@type": "Question",
      "name": "Is my data used to train AI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Lesson briefings are generated by Claude (Anthropic). Your data is sent securely to produce each briefing and is not used to train any AI model."
      }
    },
    {
      "@type": "Question",
      "name": "I'm switching from paper, WhatsApp or a spreadsheet — is it hard?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Most instructors are set up in about five minutes, and you can keep your current diary running alongside until you're confident. DriveSchoolPro is free during early access and needs no card."
      }
    },
    {
      "@type": "Question",
      "name": "Which reminders can I send — email or WhatsApp?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Reminders go out by email automatically before every lesson, with configurable timing and full delivery logs. WhatsApp is coming soon."
      }
    },
    {
      "@type": "Question",
      "name": "Why is it free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Because it's early. We're building DriveSchoolPro with founding schools — your feedback shapes the product, and in return the full product is free until 31 March 2027."
      }
    }
  ]
};
---

<BaseLayout title="Driving School Software — Free until 31 March 2027" description={`Driving school software with DVSA tracking, scheduling, automated reminders, and invoicing included. ${OFFER.meta} No card required.`} image="/images/hero-pricing.jpg">
  <Fragment slot="head">
    {offerSchemas.map(offerSchema => (
      <script type="application/ld+json" set:html={JSON.stringify(offerSchema)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Pricing' }
      ]} />
    </div>
  </div>

  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('/images/hero-pricing.jpg'); background-size: cover; background-position: center;"></div>
    </div>
    <div class="container-custom relative">
      <div class="max-w-3xl text-center mx-auto">
        <span class="inline-block bg-brand-red/20 text-brand-red-light px-3 py-1 rounded-full text-sm mb-4">Early access</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Free until 31 March 2027</h1>
        <p class="text-xl text-gray-300">We're in early access, building DriveSchoolPro with founding schools. The full product is free — no card required and no setup fees. We charge 3% on card payments you collect; Stripe's own processing fee is separate.</p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-brand-navy mb-4">One Plan. Everything Included. £0.</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">
            Solo ADIs and multi-instructor schools get the full product during early access. Pricing will be announced well before 1 April 2027 — and nothing is ever charged automatically.
          </p>
          {PROMO.enabled && (
            <p class="inline-block bg-brand-red-light text-brand-navy text-sm font-medium px-4 py-2 rounded-lg">
              {PROMO.pricingNote}
            </p>
          )}
        </div>
        <div class="max-w-xl mx-auto">
          <!-- Early Access — free plan -->
          <div class="card border-2 border-brand-red ring-2 ring-brand-red/20 relative">
            <span class="badge-primary mb-2">Early access</span>
            <h3 class="text-xl font-bold text-brand-navy mb-2">Everything, free</h3>
            <p class="text-gray-600 mb-4">For independent ADIs and driving schools</p>
            <div class="text-4xl font-bold text-brand-navy mb-1">£0<span class="text-lg font-normal text-gray-500">/month</span></div>
            <p class="text-sm text-gray-500 mb-4">until 31 March 2027</p>
            <ul class="text-left space-y-2 mb-6 text-sm">
              <li>✓ Unlimited pupils & lessons</li>
              <li>✓ Scheduling with conflict detection + online booking</li>
              <li>✓ Full DVSA progress tracking (27 skills, 8 categories)</li>
              <li>✓ Invoicing & card payments via Stripe</li>
              <li>✓ Multi-instructor tools, vehicles & role-based access</li>
              <li>✓ Automated email reminders (WhatsApp coming soon)</li>
              <li>✓ AI lesson briefings (powered by Claude)</li>
              <li>✓ Student self-service portal</li>
            </ul>
            <a href={OFFER.ctaPrimary.href} class="btn-primary w-full">{OFFER.ctaPrimary.label}</a>
            <p class="text-center text-gray-500 text-xs mt-3">No card required · 3% on card payments you collect · Cancel anytime</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Enterprise / contact sales -->
  <section class="bg-white pb-16">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto bg-brand-navy text-white rounded-2xl p-8 md:p-10 text-center">
        <h2 class="text-2xl font-bold mb-3">Running 6 or more instructors?</h2>
        <p class="text-gray-300 mb-6 max-w-xl mx-auto">Early access is free for larger schools too. Tell us about your school and we'll help you get set up, with priority support and onboarding tailored to bigger teams.</p>
        <a href="/contact/" class="btn-primary">Talk to us</a>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-brand-navy mb-8 text-center">What's Included — Everything</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Drag-and-Drop Calendar</h3>
            <p class="text-gray-600 text-sm">Interactive calendar with day, week, and month heatmap views. Reschedule lessons with drag-and-drop. Recurring lesson series coming soon.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Automated Reminders</h3>
            <p class="text-gray-600 text-sm">Email reminders with configurable timing. WhatsApp coming soon. Per-student notification preferences and full delivery logs so you know every message was received.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">DVSA Progress Tracking</h3>
            <p class="text-gray-600 text-sm">Full DVSA competency framework with 27 skills across 8 DVSA categories. Track each student's journey from Not Started to Reflection on a 6-level scale.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Student Portal</h3>
            <p class="text-gray-600 text-sm">Students log in to view upcoming lessons, track their DVSA progress, check package balances, and update their personal details.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Online Booking Widget</h3>
            <p class="text-gray-600 text-sm">Embed a booking widget on your website so students can book lessons 24/7. You control available slots, lesson types, and booking rules.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Test & Document Tracking</h3>
            <p class="text-gray-600 text-sm">Track every pupil against the full DVSA framework, record lesson outcomes, and see progress at a glance across your whole school. Test bookings, test results and pass-rate reporting are coming soon.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost breakdown section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-brand-navy mb-4">How Much Does Driving School Software Cost?</h2>
        <p class="text-gray-600 mb-6">
          Driving school software pricing in the UK typically ranges from free (limited tools) to £100+/month for enterprise platforms. DriveSchoolPro is different right now — the full product is free while we're in early access:
        </p>
        <div class="overflow-x-auto mb-8">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-brand-navy text-white">
                <th class="text-left p-3 rounded-tl-lg">Who it's for</th>
                <th class="text-left p-3">Monthly cost</th>
                <th class="text-left p-3 rounded-tr-lg">Until</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-gray-200">
                <td class="p-3 font-medium">Independent ADIs</td>
                <td class="p-3 font-bold text-brand-navy">£0 <span class="text-xs font-normal text-gray-500">(early access)</span></td>
                <td class="p-3 text-gray-600">31 March 2027</td>
              </tr>
              <tr>
                <td class="p-3 font-medium">Multi-instructor schools</td>
                <td class="p-3 font-bold text-brand-navy">£0 <span class="text-xs font-normal text-gray-500">(early access)</span></td>
                <td class="p-3 text-gray-600">31 March 2027</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-gray-600 mb-4">
          Why free? Because it's early. We're building DriveSchoolPro with founding schools — your feedback shapes the product. Early users report saving 10+ hours of admin weekly, and during early access that saving costs you nothing. Pricing will be announced well before 1 April 2027, and with no card on file nothing is ever charged automatically.
        </p>
        <p class="text-gray-600">
          There are no setup fees and no per-lesson charges. We charge 3% on card payments you collect through invoice pay-links, and Stripe's standard processing fee applies on top. See <a href="/driving-school-software/" class="text-brand-red hover:underline">all driving school software features</a> included.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-brand-navy mb-8 text-center">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Is DriveSchoolPro really free?</h3>
            <p class="text-gray-600 text-sm">Yes — DriveSchoolPro is free until 31 March 2027 while we're in early access. No card is required and nothing is ever charged automatically. We charge 3% on card payments your school collects through DriveSchoolPro; Stripe's own processing fee is separate. Pricing will be announced well before 1 April 2027.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">What happens after 31 March 2027?</h3>
            <p class="text-gray-600 text-sm">We'll announce pricing well before 1 April 2027, so you'll have plenty of time to decide. Because there's no card on file, nothing is ever charged automatically — you'll only pay if you actively choose a plan when pricing launches.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Is there a contract?</h3>
            <p class="text-gray-600 text-sm">No. There's no contract, no card on file, and no cancellation fees. You can stop using DriveSchoolPro at any time.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">How do my pupils pay me?</h3>
            <p class="text-gray-600 text-sm">You can record cash, bank transfer, and cheque payments, and take card payments through Stripe pay-links on invoices. We charge 3% on card payments you collect through DriveSchoolPro, and Stripe's standard processing fee applies on top.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">How is my data kept secure, and where is it hosted?</h3>
            <p class="text-gray-600 text-sm">DriveSchoolPro is run by LEAVE.REVIEW LTD, a UK company and the data controller under UK GDPR. Payments are handled by Stripe (PCI DSS Level 1) and your data is encrypted at rest. Our sub-processors are Stripe, Neon, Vercel and Resend. See our <a href="/privacy-policy/" class="text-brand-red hover:underline">privacy policy</a> for detail.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Is my data used to train AI?</h3>
            <p class="text-gray-600 text-sm">No. Lesson briefings are generated by Claude (Anthropic). Your data is sent securely to produce each briefing and is not used to train any AI model.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">I'm switching from paper, WhatsApp or a spreadsheet — is it hard?</h3>
            <p class="text-gray-600 text-sm">No. Most instructors are set up in about five minutes, and you can keep your current diary running alongside until you're confident. DriveSchoolPro is free during early access and needs no card.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Which reminders can I send — email or WhatsApp?</h3>
            <p class="text-gray-600 text-sm">Reminders go out by email automatically before every lesson, with configurable timing and full delivery logs. WhatsApp is coming soon.</p>
          </div>
          <div class="card">
            <h3 class="font-bold text-brand-navy mb-2">Why is it free?</h3>
            <p class="text-gray-600 text-sm">Because it's early. We're building DriveSchoolPro with founding schools — your feedback shapes the product, and in return the full product is free until 31 March 2027.</p>
          </div>
        </div>
        <p class="text-sm text-gray-500 mt-6 text-center">
          Not sure if software is worth it? See <a href="/blog/switch-paper-diary-to-driving-school-software/#the-numbers" class="text-brand-red hover:underline">how much admin time it saves</a> in our switching guide.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
