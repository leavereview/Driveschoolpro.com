          <li><a href="#payments-reminders" class="hover:text-brand-red">&rarr; Payments and reminders</a></li>
          <li><a href="#paper-vs-app" class="hover:text-brand-red">&rarr; Paper diary vs app</a></li>
          <li><a href="#schools" class="hover:text-brand-red">&rarr; Shared diaries for schools</a></li>
