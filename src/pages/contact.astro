---
// Contact Page
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

// ContactPoint Schema
const contactPointSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "mainEntity": {
    "@type": "Organization",
    "@id": "https://driveschoolpro.com/#organization",
    "name": "DriveSchoolPro",
    "url": "https://driveschoolpro.com",
    "logo": "https://driveschoolpro.com/images/logo.png",
    "contactPoint": [
      {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "info@driveschoolpro.com",
        "availableLanguage": ["English"],
        "areaServed": "GB",
        "hoursAvailable": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "17:00"
        }
      },
      {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": "info@driveschoolpro.com",
        "availableLanguage": ["English"],
        "areaServed": "GB"
      },
      {
        "@type": "ContactPoint",
        "contactType": "technical support",
        "email": "info@driveschoolpro.com",
        "availableLanguage": ["English"],
        "areaServed": "GB"
      }
    ],
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "124 City Road",
      "addressLocality": "London",
      "addressRegion": "England",
      "postalCode": "EC1V 2NX",
      "addressCountry": "GB"
    }
  }
};
---

<BaseLayout title="Contact Us" description="Get in touch with DriveSchoolPro. Request a demo, ask questions, or learn how we can help streamline your driving school management." image="/images/hero-contact.jpg">
  <!-- ContactPoint Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(contactPointSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Contact' }
      ]} />
    </div>
  </div>

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('/images/hero-contact.jpg'); background-size: cover; background-position: center;"></div>
    </div>
    <div class="container-custom relative">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Get in Touch</h1>
        <p class="text-xl text-gray-300 mb-4">
          Have questions about DriveSchoolPro? We'd love to hear from you. Send us a message and we'll respond as soon as possible.
        </p>
        <p class="text-gray-400">
          Whether you're looking for a demo, need technical support, or want to discuss how our driving school software can help streamline your operations, our team is ready to assist. We typically respond within 24 hours on business days.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 max-w-6xl mx-auto">

        <!-- Contact Form -->
        <div class="card">
          <h2 class="text-2xl font-bold text-brand-navy mb-6">Send us a Message</h2>
          <form
            action="https://formspree.io/f/xkoogqqg"
            method="POST"
            class="space-y-6"
          >
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                Full Name <span class="text-brand-red">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="input"
                placeholder="John Smith"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                Email Address <span class="text-brand-red">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="input"
                placeholder="john@example.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">
                Subject <span class="text-brand-red">*</span>
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="input"
              >
                <option value="">Select a topic...</option>
                <option value="demo">Request a Demo</option>
                <option value="general">General Inquiry</option>
                <option value="support">Technical Support</option>
                <option value="partnership">Partnership Opportunity</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
                Message <span class="text-brand-red">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="input resize-none"
                placeholder="Tell us how we can help..."
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full">
              Send Message
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="space-y-6">
          <h2 class="text-2xl font-bold text-brand-navy mb-2">Contact Information</h2>
          <!-- Email Card -->
          <div class="card">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-red-light rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-brand-navy mb-1">Email Us</h3>
                <p class="text-gray-600 mb-2">For general inquiries and support</p>
                <a href="mailto:info@driveschoolpro.com" class="text-brand-red hover:text-brand-red-dark font-medium transition-colors">
                  info@driveschoolpro.com
                </a>
              </div>
            </div>
          </div>

          <!-- Address Card -->
          <div class="card">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-red-light rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-brand-navy mb-1">Office Address</h3>
                <p class="text-gray-600">
                  124 City Road<br />
                  London, England<br />
                  EC1V 2NX
                </p>
              </div>
            </div>
          </div>

          <!-- Response Time Card -->
          <div class="card">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-brand-red-light rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold text-brand-navy mb-1">Response Time</h3>
                <p class="text-gray-600">
                  We typically respond within 24 hours during business days. For urgent support, please indicate this in your message.
                </p>
              </div>
            </div>
          </div>

          <!-- CTA Card -->
          <div class="bg-brand-red-light rounded-xl p-6">
            <h3 class="text-lg font-bold text-brand-navy mb-2">Ready to get started?</h3>
            <p class="text-gray-600 mb-4">
              Try DriveSchoolPro free and see how it can transform your driving school management.
            </p>
            <a href="/pricing/" class="btn-primary">
              View Pricing
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Company Info Section -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl font-bold text-brand-navy mb-6">About Our Company</h2>
        <div class="card text-left">
          <p class="text-gray-600 mb-4">
            DriveSchoolPro is a trading name of <strong>JOHN POWELL LTD</strong>, a UK software development company established in 2005 with extensive experience building management software for service-based businesses.
          </p>
          <div class="grid sm:grid-cols-2 gap-6 mt-6 pt-6 border-t border-gray-200">
            <div>
              <h3 class="font-semibold text-brand-navy mb-2">Company Details</h3>
              <p class="text-sm text-gray-600">
                JOHN POWELL LTD<br />
                Company No: 05408918<br />
                Incorporated: 31 March 2005
              </p>
            </div>
            <div>
              <h3 class="font-semibold text-brand-navy mb-2">Registered Office</h3>
              <p class="text-sm text-gray-600">
                124 City Road<br />
                London, England<br />
                EC1V 2NX
              </p>
            </div>
          </div>
          <div class="mt-6 pt-6 border-t border-gray-200">
            <a
              href="https://find-and-update.company-information.service.gov.uk/company/05408918"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-brand-red hover:text-brand-red-dark font-medium transition-colors"
            >
              View on Companies House
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
