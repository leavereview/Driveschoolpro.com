---
// About page — company/team focused (no individual bio)
import { OFFER } from '../config/offer';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "JOHN POWELL LTD",
  "alternateName": "DriveSchoolPro",
  "url": "https://driveschoolpro.com",
  "logo": "https://driveschoolpro.com/icon-512.png",
  "foundingDate": "2005-03-31",
  "description": "UK-registered software development company providing vertical SaaS solutions for driving schools and instructors",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "124 City Road",
    "addressLocality": "London",
    "postalCode": "EC1V 2NX",
    "addressCountry": "GB"
  },
  "sameAs": [
    "https://find-and-update.company-information.service.gov.uk/company/05408918",
    "https://www.linkedin.com/company/driveschoolpro/",
    "https://www.capterra.co.uk/software/1092493/DriveSchoolPro",
    "https://www.g2.com/products/driveschoolpro/reviews",
    "https://uk.trustpilot.com/review/driveschoolpro.com",
    "https://www.producthunt.com/products/driveschoolpro"
  ]
};
---

<BaseLayout
  title="About DriveSchoolPro"
  description="DriveSchoolPro is built by the UK software team behind RevelationPets. Learn who we are, what we build for driving instructors and how to reach us."
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />

  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'About' }
      ]} />
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16 md:py-24">
    <div class="container-custom">
      <div class="max-w-3xl">
        <span class="badge-primary mb-6">About</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">The team behind DriveSchoolPro</h1>
        <p class="text-xl text-gray-300 leading-relaxed">
          We are a small UK software team that builds management software for service businesses. DriveSchoolPro brings that experience to driving instructors and driving schools: less admin, fewer no-shows and a clear view of every learner's progress.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">

        <!-- Our story -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">Who we are</h2>
          <div class="space-y-4 text-gray-600 text-lg leading-relaxed">
            <p>
              DriveSchoolPro is built and supported by the same team that created <strong class="text-brand-navy">RevelationPets</strong>, a booking and management platform used by pet care facilities in several countries, and <strong class="text-brand-navy">PetCare.Software</strong>.
            </p>
            <p>
              Over that time we learned what small service businesses actually need from software: simple scheduling, reminders that cut no-shows, records that are easy to find, and a supplier that answers when you ask for something. We are applying the same approach to driving instruction.
            </p>
          </div>
        </div>

        <!-- Principles -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">How we work</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Built for the instructor's day</h3>
              <p class="text-gray-600 text-sm">Scheduling, DVSA progress tracking, invoicing and reminders live in one place, so you are not juggling a diary, a spreadsheet and a notes app.</p>
            </div>
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Automation that stays out of the way</h3>
              <p class="text-gray-600 text-sm">We automate the admin, such as reminders, review requests and lesson briefings, while the relationship with the learner stays yours.</p>
            </div>
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Responsive support</h3>
              <p class="text-gray-600 text-sm">Real people read every message. If something is missing or does not work the way you teach, tell us and we will look at it.</p>
            </div>
            <div class="card">
              <h3 class="font-bold text-brand-navy mb-2">Honest about what the product does</h3>
              <p class="text-gray-600 text-sm">We only describe features that exist today and say clearly when something is still coming. See our <a href="/about/facts/" class="text-brand-red hover:underline">company facts page</a> for a plain summary.</p>
            </div>
          </div>
        </div>

        <!-- What the platform handles -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-4">What DriveSchoolPro handles</h2>
          <ul class="text-gray-600 space-y-2 list-disc list-inside">
            <li>AI-generated lesson briefings (powered by Anthropic's Claude)</li>
            <li>Lesson scheduling and conflict detection</li>
            <li>Learner progress tracking across all 27 DVSA skills</li>
            <li>Google review requests emailed automatically when you mark a practical pass</li>
            <li>Email reminders to cut no-shows (WhatsApp coming soon)</li>
            <li>Invoicing and payment recording</li>
          </ul>
        </div>

        <!-- Company Information -->
        <div class="mb-16 bg-gray-50 rounded-2xl p-8">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">Company information</h2>
          <p class="text-gray-600 mb-6">
            DriveSchoolPro is a trading name of <strong class="text-brand-navy">JOHN POWELL LTD</strong>, a UK-registered software development company established in 2005.
          </p>

          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Company Number</div>
              <div class="font-bold text-brand-navy">05408918</div>
            </div>
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Incorporated</div>
              <div class="font-bold text-brand-navy">31 March 2005</div>
            </div>
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Registered Office</div>
              <div class="font-bold text-brand-navy">124 City Road, London, EC1V 2NX</div>
            </div>
            <div class="bg-white rounded-xl p-4">
              <div class="text-sm text-gray-500 mb-1">Nature of Business</div>
              <div class="font-bold text-brand-navy">Business & domestic software development</div>
            </div>
          </div>

          <a
            href="https://find-and-update.company-information.service.gov.uk/company/05408918"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-brand-red hover:text-brand-red-dark font-medium"
          >
            View full company details on Companies House
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <!-- Platform Links -->
        <div class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-4">What DriveSchoolPro Offers</h2>
          <p class="text-gray-600 mb-8">
            DriveSchoolPro is a complete management platform for UK driving instructors and school owners. Explore the core areas of the platform below.
          </p>
          <div class="grid sm:grid-cols-2 gap-4">
            <a href="/" class="card p-6 hover:border-brand-red border border-transparent transition-colors group">
              <h3 class="font-bold text-brand-navy group-hover:text-brand-red mb-2 transition-colors">Driving School Software</h3>
              <p class="text-sm text-gray-600">The full-featured management platform — scheduling, DVSA progress tracking, invoicing, and automated reminders in one place.</p>
              <span class="inline-flex items-center gap-1 text-brand-red text-sm font-semibold mt-3">
                Explore platform
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
            <a href="/driving-school-management-software/" class="card p-6 hover:border-brand-red border border-transparent transition-colors group">
              <h3 class="font-bold text-brand-navy group-hover:text-brand-red mb-2 transition-colors">Driving School Management Software</h3>
              <p class="text-sm text-gray-600">Student records, payment processing, reporting, and business analytics — everything you need to run your school efficiently.</p>
              <span class="inline-flex items-center gap-1 text-brand-red text-sm font-semibold mt-3">
                Explore management tools
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
            <a href="/driving-school-scheduling-software/" class="card p-6 hover:border-brand-red border border-transparent transition-colors group">
              <h3 class="font-bold text-brand-navy group-hover:text-brand-red mb-2 transition-colors">Driving School Scheduling Software</h3>
              <p class="text-sm text-gray-600">Lesson booking, instructor calendars, three-way conflict detection, and automated email reminders to cut no-shows (WhatsApp coming soon).</p>
              <span class="inline-flex items-center gap-1 text-brand-red text-sm font-semibold mt-3">
                Explore scheduling
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
            <a href="/free-driving-school-software/" class="card p-6 hover:border-brand-red border border-transparent transition-colors group">
              <h3 class="font-bold text-brand-navy group-hover:text-brand-red mb-2 transition-colors">Free Driving School Software</h3>
              <p class="text-sm text-gray-600">Compare free and paid options — understand what you actually get for free and where paid plans pay for themselves.</p>
              <span class="inline-flex items-center gap-1 text-brand-red text-sm font-semibold mt-3">
                Compare free vs paid
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </span>
            </a>
          </div>
        </div>

        <!-- Connect -->
        <div class="text-center">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">Get in touch</h2>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="https://www.linkedin.com/company/driveschoolpro/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary"
            >
              DriveSchoolPro on LinkedIn
            </a>
            <a href="/contact/" class="btn-primary">Contact us</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Listed On / Directory Badges -->
  <section class="py-12 bg-gray-50 border-y border-gray-100">
    <div class="container-custom">
      <p class="text-center text-sm font-semibold text-gray-400 uppercase tracking-widest mb-8">
        Listed On
      </p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
        {[
          { name: 'Product Hunt', href: 'https://www.producthunt.com/products/driveschoolpro', file: 'product-hunt.svg' },
          { name: 'Capterra',     href: 'https://www.capterra.co.uk/software/1092493/DriveSchoolPro', file: 'capterra.svg'     },
          { name: 'SaaSHub',      href: 'https://www.saashub.com/driveschoolpro', file: 'saashub.svg'      },
          { name: 'G2',           href: 'https://www.g2.com/products/driveschoolpro/reviews', file: 'g2.svg'           },
          { name: 'FreeIndex',    href: 'https://www.freeindex.co.uk/profile(driveschoolpro)_859501.htm', file: 'freeindex.svg'    },
        ].map(({ name, href, file }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${name} listing`}
            class="badge-logo"
          >
            <img
              src={`/images/badges/${file}`}
              alt={`${name} logo`}
              width="120"
              height="36"
              loading="lazy"
            />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section bg-gradient-to-r from-brand-red to-brand-red-dark text-white">
    <div class="container-custom text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        Ready to simplify your driving school admin?
      </h2>
      <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        See how DriveSchoolPro handles scheduling, progress tracking and reminders in one place.
      </p>
      <a href={OFFER.ctaPrimary.href} class="btn bg-white text-brand-red hover:bg-gray-100 text-lg px-8 py-4">
        {OFFER.ctaPrimary.label}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .badge-logo img {
    filter: grayscale(1) opacity(0.55);
    transition: filter 0.2s ease, opacity 0.2s ease;
    height: 36px;
    width: auto;
  }
  .badge-logo:hover img {
    filter: grayscale(0) opacity(1);
  }
</style>
