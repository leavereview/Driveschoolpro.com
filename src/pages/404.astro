---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="min-h-[70vh] flex items-center bg-gradient-to-br from-brand-navy to-gray-900 text-white">
    <div class="container-custom py-20">
      <div class="max-w-2xl mx-auto text-center">
        <img src="/images/404-road.jpg" alt="Open road" class="w-48 h-48 object-cover rounded-full mx-auto mb-8 border-4 border-brand-red/30" />
        <div class="text-8xl font-bold text-brand-red mb-4">404</div>
        <h1 class="text-3xl md:text-4xl font-bold mb-4">Page Not Found</h1>
        <p class="text-xl text-gray-300 mb-8">
          Oops! Looks like you've taken a wrong turn. Let's get you back on the road.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn-primary text-lg px-8 py-4">
            Go Home
          </a>
          <a href="/contact/" class="btn-secondary text-lg px-8 py-4">
            Contact Us
          </a>
        </div>
        <div class="mt-12 pt-8 border-t border-white/10">
          <p class="text-gray-400 mb-4">Popular pages:</p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/" class="text-brand-red hover:underline">Driving School Software</a>
            <a href="/driving-school-scheduling-software/" class="text-brand-red hover:underline">Scheduling Software</a>
            <a href="/pricing/" class="text-brand-red hover:underline">Pricing</a>
            <a href="/blog/" class="text-brand-red hover:underline">Blog</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
