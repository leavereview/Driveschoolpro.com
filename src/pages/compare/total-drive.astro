---
import CompetitorComparison from '../../components/compare/CompetitorComparison.astro';

// Competitor cells reflect Total Drive's own public pages, checked 21 Sep 2026:
//   /driving-instructor-app/ (Smart Gaps, migration support, syllabus, reminders)
//   /knowledge-base/getting-started-for-instructors/ (syllabus pre-filled with DVSA syllabus)
// "Not listed" = not found on those pages; never "No" unless the vendor says so.
const rows = [
  { label: 'AI lesson briefings', values: [true, 'Not listed'] },
  { label: 'DVSA 27-skill, 8-category progress tracking', values: [true, 'Yes (customisable)'] },
  { label: 'Google review requests at each test pass', values: [true, 'Not listed'] },
  { label: 'Automatic lesson reminders', values: ['Email', 'Yes'] },
  { label: 'WhatsApp reminders', values: ['Coming soon', 'Not listed'] },
  { label: 'Booking widget for your own website', values: [true, 'Online booking listed'] },
  { label: 'Clash checks across pupil, instructor and vehicle', values: [true, 'Not listed'] },
  { label: 'Vehicle MOT, tax and insurance tracking', values: [true, 'Not listed'] },
  { label: 'Pupil app or portal', values: ['Yes (iOS, Android or web)', 'Yes'] },
  { label: 'Multi-instructor schools', values: [true, true] },
  { label: 'Test bookings and results recording (coming soon)', values: ['Coming soon', 'Yes'] },
  { label: 'Cancellation-gap broadcast to pupils', values: [false, 'Yes (Smart Gaps)'] },
  { label: 'Theory content', values: [false, 'Yes (Theory Suite)'] },
  { label: 'Free migration of your existing records', values: [false, 'Migration support listed'] },
];

const faqs = [
  {
    question: 'Does Total Drive use the DVSA syllabus?',
    answer: "Yes. Total Drive's own help pages say its Progress Syllabus is pre-filled with the standard DVSA syllabus, and that you can add categories and skills of your own. DriveSchoolPro tracks the official 27 skills in 8 categories, so both start from the same framework.",
    links: [{ text: 'How DriveSchoolPro tracks progress', url: '/how-progress-works/' }],
  },
  {
    question: 'What if I want to move my data back?',
    answer: "Your data is yours. The account owner can download a copy of everything held for your organisation from Settings, then Profile: pupil records, lesson history, payments and skill records. It's a JSON file, so it's a complete record rather than a spreadsheet ready to import elsewhere. Login tokens and payment links are left out.",
    links: [{ text: 'Contact us', url: '/contact/' }],
  },
  {
    question: 'Is this a fair comparison?',
    answer: "We've tried to make it one. The Total Drive column only records what Total Drive's own public website says, checked on 21 September 2026. Where we couldn't find a feature we say \"Not listed\", not \"No\". We don't quote Total Drive's prices because they change, so use their own pricing page. The gaps in DriveSchoolPro are set out above. If you spot an error, email info@driveschoolpro.com and we'll correct it.",
    links: [{ text: "Total Drive's current pricing", url: 'https://totaldrive.co.uk/instructor-software-pricing/' }],
  },
  {
    question: 'Do I have to switch all at once?',
    answer: "No. Keep your current diary running alongside DriveSchoolPro until you're confident everything's in. There's no big switch-over day, and it's free until 31 March 2027 with no card required.",
    links: [{ text: 'Get started free', url: 'https://app.driveschoolpro.com/signup' }],
  },
];
---

<CompetitorComparison
  competitor={{ name: 'Total Drive', slug: 'total-drive', pricingUrl: 'https://totaldrive.co.uk/instructor-software-pricing/' }}
  seo={{
    title: 'DriveSchoolPro vs Total Drive: Honest Comparison | DriveSchoolPro',
    description: 'Side-by-side comparison of DriveSchoolPro and Total Drive. Features, pricing, AI lesson briefings, automated reviews, and which platform suits UK ADIs best.',
    schemaDescription: 'Feature-by-feature comparison of DriveSchoolPro and Total Drive for UK driving instructors, including what DriveSchoolPro does not do yet.',
    datePublished: '2026-04-19',
    dateModified: '2026-09-21',
  }}
  checkedOn="21 September 2026"
  heroIntro="A plain, feature-by-feature comparison for instructors already using Total Drive. It covers what's different, and what DriveSchoolPro doesn't do yet."
  featuredAnswer="DriveSchoolPro and Total Drive are both UK driving school platforms with DVSA-based progress tracking, diary, reminders and a pupil app. DriveSchoolPro adds AI lesson briefings, Google review requests at each test pass, clash checks across pupil, instructor and vehicle, and vehicle compliance tracking. Total Drive is the more established platform and lists a theory suite, cancellation-gap broadcasts and migration support that DriveSchoolPro doesn't have yet."
  intro="This page is for an instructor who uses Total Drive today and is wondering whether DriveSchoolPro is worth a look. You don't have to leave: you can run both side by side and decide after a week of real lessons."
  rows={rows}
  switchHeading="Why some instructors try DriveSchoolPro"
  switchIntro="These are the differences that exist today, from the table above. None of them is a reason to switch on its own."
  switchItems={[
    {
      title: 'Lesson prep written for you',
      body: "Before each lesson, DriveSchoolPro writes a short briefing from your last notes and the pupil's skill ratings, using Claude. We couldn't find an equivalent on Total Drive's site.",
    },
    {
      title: 'Review requests at the right moment',
      body: 'When a pupil passes, they appear on your Today screen with a Google review request ready to send. It is prompted, not automatic: you decide whether to send it.',
    },
    {
      title: 'Clash checks and vehicle tracking',
      body: 'Bookings are checked against the pupil, the instructor and the vehicle together, and MOT, tax and insurance dates are tracked with alerts.',
    },
    {
      title: 'Free while in early access',
      body: "DriveSchoolPro has no subscription fee until 31 March 2027 and doesn't ask for a card. Pricing will be announced well before 1 April 2027, and nothing is charged automatically.",
    },
  ]}
  gapsHeading="What DriveSchoolPro doesn't do yet"
  gapsBody="There's no theory content in DriveSchoolPro, and no way to broadcast a cancelled slot to your pupils. We don't offer free bulk migration of your records yet. Lesson reminders go out by email only today (WhatsApp is coming soon), and recording test bookings and results is coming soon. Total Drive has also been in the UK market longer. If any of these decides it for you, that's a fair reason to stay where you are."
  sources={[
    { label: "Total Drive — app overview", url: 'https://totaldrive.co.uk/driving-instructor-app/' },
    { label: "Total Drive — getting started for instructors", url: 'https://totaldrive.co.uk/knowledge-base/getting-started-for-instructors/' },
    { label: "Total Drive — pricing", url: 'https://totaldrive.co.uk/instructor-software-pricing/' },
  ]}
  faqs={faqs}
  faqTitle="DriveSchoolPro vs Total Drive — common questions"
/>
