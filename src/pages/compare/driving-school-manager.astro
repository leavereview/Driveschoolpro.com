---
import CompetitorComparison from '../../components/compare/CompetitorComparison.astro';

// Competitor cells reflect Driving School Manager's own public pages, checked 16 Oct 2026:
//   drivingschoolmanager.com (branded school website on own domain, Stripe to the school's account)
//   /features (calendar, double-booking prevention, student portal, email + push reminders,
//     instructor assignment modes, revenue reporting; native app, SMS, DVSA test booking
//     integration and MTD/Xero listed as "coming Q3 2026")
//   /pricing (per active student, three tiers, 14-day trial; top tier quote only)
// No app-store listing found. "Not listed" = not found on those pages; never "No" unless the vendor says so.
const rows = [
  { label: 'AI lesson briefings', values: [true, 'Not listed'] },
  { label: 'DVSA 27-skill, 8-category progress tracking', values: [true, 'Progress tracking listed; DVSA skills not listed'] },
  { label: 'Native iPhone and Android apps', values: [true, 'Listed as coming (Q3 2026)'] },
  { label: 'Pupil app or portal', values: ['Yes (iOS, Android or web)', 'Yes (web portal)'] },
  { label: 'Automatic lesson reminders', values: ['Email', 'Yes (email and push; SMS listed as coming)'] },
  { label: 'WhatsApp reminders', values: ['Coming soon', 'Not listed'] },
  { label: 'Pupils book online', values: [true, 'Yes (through the student portal)'] },
  { label: 'Clash checks across pupil, instructor and vehicle', values: [true, 'Double-booking prevention listed; vehicles not stated'] },
  { label: 'Vehicle MOT, tax and insurance tracking', values: [true, 'Not listed'] },
  { label: 'Card payments through Stripe', values: [true, 'Yes (into the school\'s own Stripe account)'] },
  { label: 'Multi-instructor schools', values: [true, true] },
  { label: 'Automatic pupil-to-instructor assignment', values: ['Not listed', 'Yes (three modes)'] },
  { label: 'Branded school website on your own domain', values: [false, 'Yes'] },
  { label: 'Instructor recruitment pipeline', values: [false, 'Yes'] },
  { label: 'Test bookings and results recording (coming soon)', values: ['Coming soon', 'DVSA test booking integration listed as coming'] },
  { label: 'Permanent free plan', values: ['Yes, from 1 April 2027 (free until then)', 'Not listed (14-day free trial)'] },
  { label: 'How the price is worked out', values: ['Per instructor', 'Per active student'] },
];

const faqs = [
  {
    question: 'Does Driving School Manager have a mobile app?',
    answer: "Not yet, according to its own features page, which lists a native mobile app as coming in Q3 2026. Pupils use a web portal today. DriveSchoolPro has apps on the App Store and Google Play for instructors and pupils, and works in any web browser too.",
    links: [{ text: 'DriveSchoolPro for driving instructors', url: '/driving-instructor-software/' }],
  },
  {
    question: 'Does either track the DVSA 27 skills?',
    answer: "DriveSchoolPro tracks all 27 DVSA skills in 8 categories, recorded lesson by lesson, and pupils see their own progress. Driving School Manager lists student progress tracking but doesn't mention the DVSA skills, and its site says it is behind on DVSA integration.",
    links: [{ text: 'How DriveSchoolPro tracks progress', url: '/how-progress-works/' }],
  },
  {
    question: 'Which is better for a multi-instructor school?',
    answer: "Both are built for schools with several instructors. Driving School Manager adds a branded school website, an instructor recruitment pipeline and automatic pupil assignment. DriveSchoolPro adds native apps, DVSA 27-skill tracking, AI lesson briefings and vehicle MOT, tax and insurance tracking. From 1 April 2027 the DriveSchoolPro School plan is £22 a month plus £10 per extra instructor, with no VAT charged.",
    links: [{ text: 'DriveSchoolPro for driving schools', url: '/driving-school-software-uk/' }],
  },
  {
    question: 'Is this a fair comparison?',
    answer: "We've tried to make it one. The Driving School Manager column only records what Driving School Manager's own public website says, checked on 16 October 2026. Where we couldn't find a feature we say \"Not listed\", not \"No\". Features it lists as coming are marked that way. We don't quote its prices because they change, so use its own pricing page. If you spot an error, email info@driveschoolpro.com and we'll correct it.",
    links: [{ text: "Driving School Manager's current pricing", url: 'https://drivingschoolmanager.com/pricing' }],
  },
  {
    question: 'Do I have to switch all at once?',
    answer: "No. Keep your current system running alongside DriveSchoolPro until you're confident everything's in. It's free until 31 March 2027 with no card required.",
    links: [{ text: 'Get started free', url: 'https://app.driveschoolpro.com/signup' }],
  },
];
---

<CompetitorComparison
  competitor={{ name: 'Driving School Manager', slug: 'driving-school-manager', pricingUrl: 'https://drivingschoolmanager.com/pricing' }}
  seo={{
    title: 'DriveSchoolPro vs Driving School Manager: Comparison | DriveSchoolPro',
    description: 'Compare DriveSchoolPro and Driving School Manager feature by feature: apps, DVSA 27-skill tracking, reminders, vehicle checks and school websites. DriveSchoolPro is free until 31 March 2027.',
    schemaDescription: 'Feature-by-feature comparison of DriveSchoolPro and Driving School Manager for UK driving schools, including what DriveSchoolPro does not do.',
    datePublished: '2026-10-16',
    dateModified: '2026-10-16',
  }}
  checkedOn="16 October 2026"
  heroIntro="A plain, feature-by-feature comparison for UK driving schools weighing up Driving School Manager. It covers what's different, and what DriveSchoolPro doesn't do."
  featuredAnswer="DriveSchoolPro and Driving School Manager are both UK software for multi-instructor driving schools, with online booking, Stripe card payments and a pupil portal. DriveSchoolPro adds iPhone and Android apps, DVSA 27-skill tracking, AI lesson briefings and vehicle MOT, tax and insurance tracking. Driving School Manager adds a branded school website on your own domain, an instructor recruitment pipeline and automatic pupil-to-instructor assignment, and it prices by active student rather than by instructor."
  intro="This page is for a school owner looking at Driving School Manager and wondering whether DriveSchoolPro is worth a look too. Driving School Manager is a UK product with some features we don't have, so this isn't a case against it. It's a list of what's different."
  rows={rows}
  switchHeading="Where DriveSchoolPro differs"
  switchIntro="These are the differences that exist today, from the table above."
  switchItems={[
    {
      title: 'Apps for instructors and pupils now',
      body: "DriveSchoolPro is on the App Store and Google Play, and works in a web browser too. Driving School Manager's features page lists its native app as coming.",
    },
    {
      title: 'The full DVSA framework',
      body: "DriveSchoolPro tracks the official 27 skills across 8 categories, lesson by lesson, and pupils see their own progress. Driving School Manager lists general progress tracking.",
    },
    {
      title: 'Lesson prep written for you',
      body: "Before each lesson, DriveSchoolPro writes a short briefing from your last notes and the pupil's skill ratings, using Claude. We couldn't find an equivalent on Driving School Manager's site.",
    },
    {
      title: 'Vehicle clash checks and compliance',
      body: 'Bookings are checked against the pupil, the instructor and the vehicle together, and MOT, tax and insurance dates are tracked with alerts.',
    },
    {
      title: 'A permanent free plan',
      body: "DriveSchoolPro is free until 31 March 2027 with no card. From 1 April 2027 there's a permanent Free plan (1 instructor, up to 60 lessons a month), Solo at £22 a month, or School at £22 a month plus £10 per extra instructor, with no VAT charged.",
    },
  ]}
  gapsHeading="What DriveSchoolPro doesn't do"
  gapsBody="DriveSchoolPro doesn't build you a school website. It gives you a booking widget to put on the website you already have, where Driving School Manager hosts a branded site on your own domain. We don't have an instructor recruitment and onboarding pipeline, and we don't assign pupils to instructors automatically. Recording test bookings and results is coming soon. Lesson reminders go out by email only for now (WhatsApp is coming soon). If any of these decides it for you, that's a fair reason to choose Driving School Manager."
  sources={[
    { label: 'Driving School Manager: home', url: 'https://drivingschoolmanager.com/' },
    { label: 'Driving School Manager: features', url: 'https://drivingschoolmanager.com/features' },
    { label: 'Driving School Manager: pricing', url: 'https://drivingschoolmanager.com/pricing' },
  ]}
  faqs={faqs}
  faqTitle="DriveSchoolPro vs Driving School Manager: common questions"
/>
