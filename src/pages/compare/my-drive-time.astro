---
import CompetitorComparison from '../../components/compare/CompetitorComparison.astro';

// Competitor cells reflect MyDriveTime's own public pages, first checked 21 Sep 2026:
//   www.mydrivetime.co.uk/ and /pricing/ (SMS included, free migration, gaps,
//   student app, test outcome recording, Schools & Teams plan, syllabus manager)
// 12 Nov 2026: re-checked home page (via fetch; the pricing page is Cloudflare-blocked to scripts, so
//   pricing details are not quoted). Home page confirms: "We'll migrate your records from any other system
//   at no cost", SMS included on the Individual plan, Diary Gaps, Journey Tracking, Expense Receipts, student app.
//   Pricing page: free 30-day trial, free for PDIs until qualified. No cell changed except our own import row.
// "Not listed" = not found on those pages; never "No" unless the vendor says so.
// 16 Oct 2026: clash row updated - home page now lists "Clash Resolution".
// 2 Nov 2026: re-checked www.mydrivetime.co.uk/. The vendor writes its name as one word,
//   "MyDriveTime", so the page now uses that (keeping "My Drive Time" as the alternate
//   spelling people search). Added rows from the home page feature list: Enhanced
//   Recurrence, Expense Receipts / Income and Expense Report, Test Fault Recording.
// 9 Nov 2026: re-checked every page in the vendor's sitemap, including blog posts, release
//   notes and the Google Play / App Store listings. Fixed: DVSA syllabus (/lesson-management/:
//   "We'll get you started with the standard DVSA syllabus, but you can fully customise it");
//   reminder channels (app notifications and SMS; email reminders not found); website cell
//   (embeddable web enquiry form for teams). Added: Journey Tracking (route recording).
const rows = [
  { label: 'AI lesson briefings', values: [true, 'Not listed'] },
  { label: 'DVSA 27-skill, 8-category progress tracking', values: [true, 'Starts from the DVSA syllabus, fully customisable'] },
  { label: 'Google review requests at each test pass', values: [true, 'Not listed'] },
  { label: 'Automatic lesson reminders', values: ['Email', 'Yes (app notifications and SMS)'] },
  { label: 'WhatsApp reminders', values: ['Coming soon', 'Not listed'] },
  { label: 'Booking widget for your own website', values: [true, 'Website enquiry form (teams); online booking not listed'] },
  { label: 'Clash checks across pupil, instructor and vehicle', values: [true, 'Clash Resolution listed; scope not stated'] },
  { label: 'Vehicle MOT, tax and insurance tracking', values: [true, 'Not listed'] },
  { label: 'Pupil app or portal', values: ['Yes (iOS, Android or web)', 'Yes (student app)'] },
  { label: 'Multi-instructor schools', values: [true, 'Yes (Schools & Teams)'] },
  { label: 'Test bookings and results recording (coming soon)', values: ['Coming soon', 'Yes (test outcomes and test faults)'] },
  { label: 'Repeating weekly bookings', values: ['Coming soon', 'Yes (Enhanced Recurrence)'] },
  { label: 'Expenses and receipts', values: [false, 'Yes (Expense Receipts, Income and Expense Report)'] },
  { label: 'Cancellation-gap broadcast to pupils', values: [false, 'Yes (Diary Gaps)'] },
  { label: 'Theory content', values: [false, 'Not listed'] },
  { label: 'Moving your existing records across', values: ['Pupil import from a MyDriveTime or Total Drive spreadsheet (pupils only, not lessons or payments)', 'Yes, free data transfer from any other system (at no cost)'] },
  { label: 'Recording the route driven on each lesson', values: [false, 'Yes (Journey Tracking)'] },
];

const faqs = [
  {
    question: 'What is a good alternative to MyDriveTime?',
    answer: "For UK driving instructors the main alternatives are Total Drive (offline diary, branded pupil app, Smart Gaps, theory suite), GoRoadie Pro (iPhone and Android app with a free learner app, payments and receipt scanning), Lesson Diary (browser and iPhone app built around filling cancellations) and DriveSchoolPro (DVSA 27-skill tracking, AI lesson briefings and Stripe card payments, free until 31 March 2027). Which suits you depends on what you use most in MyDriveTime: if it is SMS reminders, diary gaps or expenses, check those first, because DriveSchoolPro doesn't have them yet.",
    links: [{ text: 'Total Drive vs DriveSchoolPro', url: '/compare/total-drive/' }, { text: 'GoRoadie vs DriveSchoolPro', url: '/compare/goroadie/' }],
  },
  {
    question: 'Is MyDriveTime the same as My Drive Time?',
    answer: "Yes. The app's own website, mydrivetime.co.uk, writes the name as one word, MyDriveTime, but plenty of instructors search for it as My Drive Time. Both mean the same UK driving instructor app, which this page compares with DriveSchoolPro.",
    links: [{ text: 'MyDriveTime website', url: 'https://www.mydrivetime.co.uk/' }],
  },
  {
    question: 'Should I stay with MyDriveTime for the support?',
    answer: "It's a fair reason to stay. MyDriveTime describes its help and support as award-winning, and DriveSchoolPro is newer, so we can't point to the same track record. If you'd like to try us alongside it, email info@driveschoolpro.com with any question and we'll answer it.",
    links: [{ text: 'Contact us', url: '/contact/' }],
  },
  {
    question: 'Does MyDriveTime track the DVSA skills?',
    answer: "Yes. MyDriveTime's Lesson Management page says it gets you started with the standard DVSA syllabus, which you can fully customise, or you can create your own syllabus from scratch. DriveSchoolPro tracks the official 27 skills in 8 categories as a fixed framework, and pupils see their own progress in their portal.",
    links: [{ text: 'How DriveSchoolPro tracks progress', url: '/how-progress-works/' }],
  },
  {
    question: 'What if I want to move my data back?',
    answer: "Your data is yours. The account owner can download a copy of everything held for your organisation from Settings, then Profile: pupil records, lesson history, payments and skill records. It's a JSON file, so it's a complete record rather than a spreadsheet ready to import elsewhere. Login tokens and payment links are left out.",
    links: [{ text: 'Contact us', url: '/contact/' }],
  },
  {
    question: 'How does MyDriveTime compare with Total Drive?',
    answer: "Both are established UK instructor apps with a diary, clash warnings, a pupil app, syllabus-based progress, SMS reminders and cancellation-gap broadcasts. On their own sites, Total Drive lists a theory suite, a calendar feed to Google, Apple and Outlook, online booking with card payments and Apple CarPlay and Android Auto, and sells SMS as a separate text bundle. MyDriveTime includes SMS on its individual plan, lists journey tracking and offers free data transfer. Our three-way comparison sets them side by side with DriveSchoolPro.",
    links: [{ text: 'Total Drive vs MyDriveTime', url: '/compare/total-drive-vs-mydrivetime/' }],
  },
  {
    question: 'Is this a fair comparison?',
    answer: "We've tried to make it one. The MyDriveTime column only records what MyDriveTime's own public website says, first checked on 21 September 2026 and re-checked on 9 November 2026 (including its blog, release notes and app store listings) and 12 November 2026. Where we couldn't find a feature we say \"Not listed\", not \"No\". We don't quote MyDriveTime's prices because they change, so use their own pricing page. The gaps in DriveSchoolPro are set out above. If you spot an error, email info@driveschoolpro.com and we'll correct it.",
    links: [{ text: "MyDriveTime's current pricing", url: 'https://www.mydrivetime.co.uk/pricing/' }],
  },
  {
    question: 'Do I have to switch all at once?',
    answer: "No. Keep your current diary running alongside DriveSchoolPro until you're confident everything's in. There's no big switch-over day, and it's free until 31 March 2027 with no card required.",
    links: [{ text: 'Get started free', url: 'https://app.driveschoolpro.com/signup' }],
  },
];
---

<CompetitorComparison
  competitor={{ name: 'MyDriveTime', alternateName: 'My Drive Time', slug: 'my-drive-time', pricingUrl: 'https://www.mydrivetime.co.uk/pricing/' }}
  h1="MyDriveTime vs DriveSchoolPro"
  seo={{
    title: `MyDriveTime vs DriveSchoolPro: ${rows.length} Features Compared`,
    description: `MyDriveTime (My Drive Time) vs DriveSchoolPro on ${rows.length} features, checked 12 Nov 2026, with what we lack and how to import your pupils. Free to 31 March 2027.`,
    schemaDescription: 'Feature-by-feature comparison of DriveSchoolPro and MyDriveTime for UK driving instructors, including what DriveSchoolPro does not do yet.',
    datePublished: '2026-09-21',
    dateModified: '2026-11-12',
  }}
  checkedOn="12 November 2026"
  heroIntro="Searching for MyDriveTime (or My Drive Time)? This is a plain, feature-by-feature comparison with DriveSchoolPro for UK driving instructors. It covers what's different, what we don't do yet, and how to bring your pupils across."
  featuredAnswer="DriveSchoolPro and MyDriveTime are both UK platforms for driving instructors, with a diary, pupil progress tracking that starts from the DVSA syllabus, and a pupil app. DriveSchoolPro adds AI lesson briefings, Google review requests at each test pass, clash checks that include the vehicle, and vehicle compliance tracking. MyDriveTime lists SMS reminders, diary-gap broadcasts, expenses, journey tracking and free migration that DriveSchoolPro doesn't have yet."
  intro="This page is for an instructor who uses MyDriveTime today and is wondering whether DriveSchoolPro is worth a look. MyDriveTime is well liked and its support is a real strength, so this isn't a case for leaving. It's a list of what's different."
  rows={rows}
  switchHeading="How DriveSchoolPro differs from MyDriveTime"
  switchIntro="MyDriveTime's support is a strength we can't match on track record. These are the differences that exist today, from the table above."
  switchItems={[
    {
      title: 'A fixed DVSA framework',
      body: "DriveSchoolPro tracks the official 27 skills across 8 categories, and pupils see their own progress in their portal. MyDriveTime also starts you on the standard DVSA syllabus but lets you customise it or build your own, so the difference is a fixed framework versus a flexible one.",
    },
    {
      title: 'Lesson prep written for you',
      body: "Before each lesson, DriveSchoolPro writes a short briefing from your last notes and the pupil's skill ratings, using Claude. We couldn't find an equivalent on MyDriveTime's site.",
    },
    {
      title: 'Review requests at the right moment',
      body: "When you mark a pupil's practical test as passed, DriveSchoolPro emails them a request to review you on Google, once. It's on by default and you can switch it off in settings.",
    },
    {
      title: 'Clash checks and vehicle tracking',
      body: "Bookings are checked against the pupil, the instructor and the vehicle together, and MOT, tax and insurance dates are tracked with alerts. MyDriveTime's diary also warns you of clashes; its site doesn't say whether vehicles are included.",
    },
    {
      title: 'Free while in early access',
      body: "DriveSchoolPro has no subscription fee until 31 March 2027 and doesn't ask for a card. From 1 April 2027 there's a permanent Free plan (1 instructor, up to 60 lessons a month), Solo at £22 a month, or School at £22 a month plus £10 per extra instructor, with no VAT charged.",
    },
  ]}
  gapsHeading="What MyDriveTime does that DriveSchoolPro doesn't yet"
  gapsBody="There's no theory content in DriveSchoolPro, and no way to broadcast a cancelled slot to your pupils, which MyDriveTime lists as Diary Gaps. We can import your pupil list from a spreadsheet, but not lesson history or payments, while MyDriveTime says it migrates your records from any other system at no cost. We don't track expenses or produce an income and expense report, so you'd pair DriveSchoolPro with accounting software. Repeating weekly bookings are coming soon; MyDriveTime lists them today. Lesson reminders go out by email only today (WhatsApp is coming soon), and recording test bookings and results is coming soon. MyDriveTime also records the route driven on each lesson (Journey Tracking) and says its mobile app works offline; DriveSchoolPro doesn't offer route recording or advertise offline use. MyDriveTime has also been around longer. If any of these decides it for you, that's a fair reason to stay where you are."
  sources={[
    { label: 'MyDriveTime — home page', url: 'https://www.mydrivetime.co.uk/' },
    { label: 'MyDriveTime — pricing', url: 'https://www.mydrivetime.co.uk/pricing/' },
    { label: "MyDriveTime — what's in the student app", url: 'https://www.mydrivetime.co.uk/blog/whats-in-the-student-app/' },
    { label: 'MyDriveTime — lesson management (DVSA syllabus, journey tracking)', url: 'https://www.mydrivetime.co.uk/lesson-management/' },
    { label: 'MyDriveTime — diary management (clashes, reminders, sharing)', url: 'https://www.mydrivetime.co.uk/diary-management/' },
    { label: 'MyDriveTime — for driving instructors (works offline)', url: 'https://www.mydrivetime.co.uk/driving-instructor-app/' },
    { label: 'MyDriveTime — web enquiry form for teams', url: 'https://www.mydrivetime.co.uk/blog/web-enquiry-form/' },
    { label: 'Lesson Diary home page (alternatives list, checked 3 November 2026)', url: 'https://lessondiary.co.uk/' },
  ]}
  switching={{
    heading: 'Switching from MyDriveTime',
    intro: "You don't have to move everything at once. You can bring your pupil list across and run both diaries side by side until you're sure.",
    steps: [
      'In the MyDriveTime app, go to Students, tap the three-dot menu and choose Export to CSV.',
      'In DriveSchoolPro, open Settings, then Import Pupils (the account owner can do this).',
      'Choose MyDriveTime export and upload the file as it is. DriveSchoolPro reads its columns for you.',
      'Check the preview and tap Import. Pupils you already have are skipped, and you see how many were added.',
    ],
    note: 'The import covers pupil details only: no lesson history, payments or prepaid hours yet. Book your upcoming lessons into DriveSchoolPro by hand, and keep MyDriveTime for your records for as long as you need them.',
    link: { text: 'See how importing pupils works', href: '/start/first-pupil/' },
  }}
  alternativesKey="mydrivetime"
  faqs={faqs}
  faqTitle="DriveSchoolPro vs MyDriveTime — common questions"
  updates={[{ date: '12 November 2026', text: 're-checked MyDriveTime\'s home page and pricing details. Nothing in the table changed, except that DriveSchoolPro can now import pupils from a spreadsheet, and we added a Switching from MyDriveTime section.' }, { date: '9 November 2026', text: 'checked again. MyDriveTime starts from the standard DVSA syllabus, which you can customise, and the page now says so. We also corrected the reminders and website cells and added its Journey Tracking and offline app.' }]}
/>
