---
// Blog Index - /blog/
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

// Get all blog posts, sorted by date
const now = new Date();
const posts = (await getCollection('blog'))
  .filter(post => new Date(post.data.date) <= now && !post.data.noindex)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Get all unique tags
const allTags = new Set<string>();
posts.forEach(post => {
  post.data.tags?.forEach(tag => allTags.add(tag));
});
const tags = Array.from(allTags).sort();

---

<BaseLayout
  title="Driving School Blog & Resources"
  description="Driving school business insights, scheduling tips, and industry guides for driving instructors and school owners."
>
  <!-- Breadcrumbs -->
  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Blog' }
      ]} />
    </div>
  </div>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="container-custom relative">
      <div class="max-w-3xl">
        <span class="badge-primary mb-4">Resources</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">DriveSchoolPro Blog</h1>
        <p class="text-xl text-gray-300">
          Insights, guides, and tips for running a successful driving school. From scheduling optimisation to student retention strategies.
        </p>
      </div>
    </div>
  </section>

  <!-- DVSA Skills Featured Banner -->
  <section class="bg-brand-red-light border-b border-red-100 py-8">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="bg-brand-red text-white rounded-xl p-3 shrink-0">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-brand-red mb-1">New — Complete Skills Guide</p>
            <h2 class="text-xl font-bold text-brand-navy">The 27 DVSA Driving Skills Explained</h2>
            <p class="text-gray-600 text-sm mt-1">
              Every skill assessed on the UK driving test — from basics and manoeuvres to motorways and independent driving. Guides for learners and instructors.
            </p>
            <div class="flex flex-wrap gap-2 mt-3">
              {['Manoeuvres', 'Junctions', 'Observation', 'Road Types', 'Conditions'].map(cat => (
                <span class="text-xs bg-white border border-red-200 text-brand-red px-2 py-0.5 rounded-full font-medium">{cat}</span>
              ))}
            </div>
          </div>
        </div>
        <a href="/dvsa-27-driving-skills/" class="btn-primary shrink-0 whitespace-nowrap">
          Explore All 27 Skills →
        </a>
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="card group">
            <a href={`/blog/${post.slug}/`} class="block">
              {post.data.image && (
                <div class="aspect-video overflow-hidden rounded-lg mb-4 -mx-6 -mt-6">
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags?.slice(0, 2).map(tag => (
                  <span class="text-xs font-medium text-brand-red uppercase tracking-wider">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="text-xl font-bold text-brand-navy mb-2 group-hover:text-brand-red transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-600 text-sm line-clamp-2 mb-4">
                {post.data.description}
              </p>
              <div class="flex items-center justify-between text-sm text-gray-500">
                <time datetime={post.data.date}>
                  {new Date(post.data.date).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                <span class="text-brand-red font-medium group-hover:underline">
                  Read more →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-12">
          <p class="text-gray-500">No blog posts yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>

  <!-- Browse by Tag -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <h2 class="text-2xl font-bold text-brand-navy mb-6 text-center">Browse by Topic</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {tags.map(tag => (
          <a
            href={`/blog/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`}
            class="px-4 py-2 bg-white border border-gray-200 rounded-full text-sm font-medium text-gray-700 hover:border-brand-red hover:text-brand-red transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="section bg-brand-red-light">
    <div class="container-custom text-center">
      <h2 class="text-3xl font-bold text-brand-navy mb-4">Stay Updated</h2>
      <p class="text-gray-600 mb-6 max-w-xl mx-auto">
        Get the latest driving school business tips, scheduling guides, and industry insights delivered to your inbox.
      </p>
      <a href="/contact/" class="btn-primary">
        Subscribe to Updates
      </a>
    </div>
  </section>
</BaseLayout>
