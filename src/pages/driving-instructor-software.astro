---
import { OFFER, PROMO } from '../config/offer';
import LandingLayout from '../layouts/LandingLayout.astro';

const GOOGLE_ADS_ID = import.meta.env.PUBLIC_GOOGLE_ADS_ID || '';
const GOOGLE_ADS_CONVERSION_LABEL = import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL || '';

const pageUrl = 'https://driveschoolpro.com/driving-instructor-software/';

// ── Differentiator trio (icon + heading + one/two sentences) ──────────
// Reminders framed truthfully: email is live, WhatsApp is coming soon (matches the rest of the site).
const differentiators = [
  {
    title: 'AI lesson briefings',
    body: "Open a lesson and the prep is already written — a short briefing from your last notes and where the pupil is up to. Powered by Claude. Switch it off any time.",
    path: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    title: 'DVSA progress tracking',
    body: 'Mark progress against the full DVSA framework — all 8 categories and 27 skills — lesson by lesson. Pupils follow along in their own portal.',
    path: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  },
  {
    title: 'Reminders that cut no-shows',
    body: 'Automated email reminders go out before every lesson, so fewer pupils forget. WhatsApp reminders are coming soon.',
    path: 'M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z',
  },
];

// ── Feature grid — one line each ──────────────────────────────────────
const features = [
  { name: 'Drag-and-drop diary', desc: 'Day, week and month views. Drag a lesson to reschedule; clashes flag instantly.' },
  { name: 'Pupil management', desc: "Every pupil's lessons, progress, package balance and notes in one place." },
  { name: 'Online booking widget', desc: 'Embed a booking form on your own site so pupils book lessons themselves.' },
  { name: 'Payments & invoicing', desc: 'Take card payments through Stripe, send invoices and see who has paid.' },
  { name: 'Automated reminders', desc: 'Email reminders before every lesson — WhatsApp coming soon.' },
  { name: 'Simple reporting', desc: 'Your week at a glance — lessons taught, income and passes.' },
];

// ── FAQ (5) — answers kept plain-text so they match the JSON-LD ───────
const faqs = [
  {
    q: 'Do my pupils need to download an app?',
    a: "No. Pupils book and get reminders by link and email — nothing to install. They can open a self-service portal in any browser to see upcoming lessons and their DVSA progress. (WhatsApp reminders are coming soon.)",
  },
  {
    q: 'Can I move my pupils over from another app?',
    a: "There's no bulk importer yet, but setup is quick — most instructors add their pupils and first lessons in about five minutes, and you can keep your old diary running alongside until you're settled. If you get stuck, we'll help.",
  },
  {
    q: 'Does it track DVSA competencies?',
    a: 'Yes. You track the full DVSA framework — all 8 categories and 27 skills — lesson by lesson, and pupils can see their own progress through the portal.',
  },
  {
    q: 'What does it cost?',
    a: "Nothing right now. DriveSchoolPro is free while we're in early access — until 31 March 2027 — with unlimited pupils and every feature included. No card is required, and pricing will be announced well before 1 April 2027.",
  },
  {
    q: 'Is there a contract?',
    a: 'No. Plans are month-to-month — cancel any time with no fees.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faqpage`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// SoftwareApplication schema — these pages double as SEO pages.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DriveSchoolPro',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, iOS, Android',
  url: 'https://driveschoolpro.com',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'GBP',
    priceValidUntil: '2027-03-31',
    description: 'Free during early access — until 31 March 2027. For independent ADIs — unlimited pupils, DVSA tracking, scheduling, invoicing and reminders.',
  },
  description: 'Driving instructor software for UK ADIs — diary, pupil management, payments, automated reminders and full DVSA progress tracking in one app.',
};
---

<LandingLayout
  title="Driving Instructor Software UK | DriveSchoolPro"
  description="Diary, pupils, payments, reminders and DVSA progress tracking in one app for UK driving instructors. Free during early access — until 31 March 2027. No card required."
  canonicalUrl={pageUrl}
  ogImage="/images/marketing/dashboard-overview.webp"
  robots="index, follow"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} slot="head" />

  <!-- Conversion tracking — fires the Google Ads conversion, then navigates -->
  <script is:inline define:vars={{ GOOGLE_ADS_ID, GOOGLE_ADS_CONVERSION_LABEL }} slot="head">
    window.trackAdConversion = function (url) {
      if (typeof window.gtag === 'function' && GOOGLE_ADS_ID && GOOGLE_ADS_CONVERSION_LABEL) {
        window.gtag('event', 'conversion', {
          send_to: GOOGLE_ADS_ID + '/' + GOOGLE_ADS_CONVERSION_LABEL,
          event_callback: function () { window.location = url; },
        });
        setTimeout(function () { window.location = url; }, 1000);
        return false;
      }
      window.location = url;
    };
  </script>

  <!-- ── Hero ─────────────────────────────────────────────────────── -->
  <section class="bg-white pt-8 pb-10 md:pt-16 md:pb-20">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row md:items-center md:gap-12 lg:gap-16">

        <!-- Text -->
        <div class="md:w-1/2 mb-10 md:mb-0">
          <a href="/" class="inline-flex items-center gap-2 mb-6" aria-label="DriveSchoolPro home">
            <span class="text-2xl font-bold text-brand-navy tracking-tight">DriveSchool<span class="text-brand-red">Pro</span></span>
          </a>

          {PROMO.enabled && (
            <div class="inline-flex items-center gap-2 bg-brand-red-light text-brand-red text-sm font-semibold px-3 py-1.5 rounded-full mb-5">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              25% off your first 3 months with code {PROMO.code}
            </div>
          )}

          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-brand-navy leading-tight mb-4">
            Driving instructor software that runs your day, <span class="text-brand-red">not the other way round</span>
          </h1>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed">
            Diary, pupils, payments and reminders in one place — built for UK ADIs who teach from their car, not a desk.
          </p>

          <a
            href={OFFER.ctaPrimary.href}
            onclick="return trackAdConversion(this.href)"
            class="inline-block w-full md:w-auto text-center bg-brand-red text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-red-700 transition-colors"
          >
            Get started free &rarr;
          </a>
          <p class="text-sm text-gray-400 mt-3">
            No credit card required &middot; {OFFER.short} &middot;
            <a href="#pricing" class="underline hover:text-gray-600">See pricing</a>
          </p>
        </div>

        <!-- Hero image — the mobile app, because that's how ADIs actually use it -->
        <div class="md:w-1/2 flex justify-center">
          <img
            src="/images/marketing/calendar-mobile.webp"
            alt="DriveSchoolPro diary on a phone, showing a day of driving lessons"
            class="rounded-3xl shadow-xl border border-gray-100 w-auto max-h-[520px]"
            width="375"
            height="812"
            loading="eager"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ── Trust bar ─────────────────────────────────────────────────── -->
  <section class="bg-gray-50 py-6 border-y border-gray-100">
    <div class="container-custom">
      <div class="flex flex-wrap justify-center gap-6 md:gap-10 text-sm font-medium text-gray-600">
        <span class="flex items-center gap-2"><span class="text-base">🇬🇧</span> Built for UK ADIs</span>
        <span class="hidden md:block text-gray-200">|</span>
        <span class="flex items-center gap-2">27 DVSA skills tracked</span>
        <span class="hidden md:block text-gray-200">|</span>
        <span class="flex items-center gap-2">Set up in about five minutes</span>
        <span class="hidden md:block text-gray-200">|</span>
        <span class="flex items-center gap-2">UK GDPR compliant</span>
      </div>
    </div>
  </section>

  <!-- ── Differentiator trio ───────────────────────────────────────── -->
  <section class="section bg-white">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-navy text-center mb-3">
        Three things a diary app won't do
      </h2>
      <p class="text-gray-500 text-center mb-10 max-w-2xl mx-auto">
        DriveSchoolPro does the thinking between lessons, so you can keep your eyes on the road.
      </p>
      <div class="grid md:grid-cols-3 gap-6">
        {differentiators.map((d) => (
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
            <div class="w-10 h-10 rounded-lg bg-brand-red-light flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d.path} />
              </svg>
            </div>
            <p class="font-semibold text-gray-900 mb-2">{d.title}</p>
            <p class="text-gray-600 text-sm leading-relaxed">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Everything in one place ───────────────────────────────────── -->
  <section class="section bg-gray-50 border-t border-gray-100">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-navy text-center mb-3">Everything in one place</h2>
      <p class="text-gray-500 text-center mb-10 max-w-2xl mx-auto">No add-ons, no per-pupil charges. It's all included.</p>
      <div class="max-w-3xl mx-auto grid sm:grid-cols-2 gap-3">
        {features.map((f) => (
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-red flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
            <div>
              <span class="font-semibold text-gray-900 text-sm">{f.name}</span>
              <span class="text-gray-500 text-sm"> — {f.desc}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Pricing (Solo) ────────────────────────────────────────────── -->
  <section id="pricing" class="section bg-white scroll-mt-6">
    <div class="container-custom">
      <div class="max-w-md mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-3">Free while we're in early access</h2>
        <div class="bg-gray-50 border-2 border-brand-red rounded-2xl p-8 mt-6">
          <p class="text-sm font-semibold text-brand-red uppercase tracking-wider mb-2">Early access</p>
          <div class="text-5xl font-bold text-brand-navy mb-1">£0<span class="text-lg font-normal text-gray-500"> until 31 March 2027</span></div>
          <p class="text-gray-500 text-sm mb-6">Unlimited pupils · every feature included · pricing announced well before 1 April 2027</p>
          {PROMO.enabled && (
            <p class="text-brand-red text-sm font-medium bg-brand-red-light rounded-lg px-4 py-2 mb-6">
              {PROMO.pricingNote}
            </p>
          )}
          <a
            href={OFFER.ctaPrimary.href}
            onclick="return trackAdConversion(this.href)"
            class="block w-full text-center bg-brand-red text-white px-8 py-4 rounded-xl font-semibold text-lg hover:bg-red-700 transition-colors"
          >
            Get started free &rarr;
          </a>
          <p class="text-xs text-gray-400 mt-3">{OFFER.short} · no card required · nothing charged automatically</p>
        </div>
        <p class="text-sm text-gray-400 mt-6">Running a team of instructors? <a href="/driving-school-software-uk/" class="text-brand-red hover:underline">See DriveSchoolPro for driving schools &rarr;</a></p>
      </div>
    </div>
  </section>

  <!-- ── Switching reassurance ─────────────────────────────────────── -->
  <section class="section bg-gray-50 border-y border-gray-100">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-6">Switching is easier than you think</h2>
        <div class="grid sm:grid-cols-2 gap-4 text-left mb-8">
          <div class="flex items-start gap-3">
            <span class="text-brand-red font-bold">✓</span>
            <p class="text-gray-600 text-sm">No contract — free until 31 March 2027, cancel any time.</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-brand-red font-bold">✓</span>
            <p class="text-gray-600 text-sm">We'll help you move your pupils across and get set up.</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-brand-red font-bold">✓</span>
            <p class="text-gray-600 text-sm">Run it alongside your old diary until you're confident.</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-brand-red font-bold">✓</span>
            <p class="text-gray-600 text-sm">UK-based founder support — talk to the people who built it.</p>
          </div>
        </div>
        <a href="/compare/total-drive/" class="text-brand-red font-semibold hover:underline">Compare us with Total Drive &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────── -->
  <section class="section bg-white">
    <div class="container-custom">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-navy text-center mb-10">Frequently asked questions</h2>
      <div class="max-w-2xl mx-auto divide-y divide-gray-100">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-gray-900">
              {f.q}
              <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="mt-3 text-gray-600 text-sm leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────────── -->
  <section class="section bg-brand-navy text-white text-center">
    <div class="container-custom">
      <h2 class="text-3xl md:text-4xl font-bold mb-3">Ready to run your day from your pocket?</h2>
      <p class="text-white/80 text-lg mb-8">Set up in about five minutes. No card, no contract, cancel any time.</p>
      <a
        href={OFFER.ctaPrimary.href}
        onclick="return trackAdConversion(this.href)"
        class="inline-block w-full md:w-auto text-center bg-brand-red text-white px-10 py-4 rounded-xl font-semibold text-lg hover:bg-red-700 transition-colors"
      >
        Get started free &rarr;
      </a>
      <p class="text-white/50 text-sm mt-3">{OFFER.short} &middot; no credit card required</p>
    </div>
  </section>

  <!-- ── Sticky mobile CTA ─────────────────────────────────────────── -->
  <div class="fixed bottom-0 left-0 right-0 z-50 p-3 bg-white/95 backdrop-blur-sm border-t border-gray-200 md:hidden">
    <a
      href={OFFER.ctaPrimary.href}
      onclick="return trackAdConversion(this.href)"
      class="block w-full text-center bg-brand-red text-white py-3 rounded-xl font-semibold hover:bg-red-700 transition-colors"
    >
      Get started free &rarr;
    </a>
  </div>
</LandingLayout>
