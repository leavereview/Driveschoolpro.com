  },
  {
    label: 'Free Until',
    value: '31 Mar 2027',
    context: 'Full access, no card required'
  },
  {
    label: 'Students',
    value: 'Unlimited',
    context: 'No caps — even while free'
  },
  {
    label: 'DVSA Skills Tracked',
    value: '27',
    context: 'Across 8 categories — more than free tools track'
  },
  {
    label: 'Conflict Detection',
    value: '3-way',
    context: 'Student, instructor and vehicle'
  },
  {
    label: 'Admin Time Saved',
    value: '10+ hrs',
    context: 'Per week — based on early user feedback'
  }
];

const comparisonData = [
  {
    label: 'Drag-and-Drop Scheduling',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Automated Email Reminders',
    values: [true, false, false],
    highlight: true
  },
  {
    label: 'Unlimited Students',
    values: [true, false, false]
  },
  {
    label: 'Invoicing & Payment Recording',
    values: [true, false, false]
  },
  {
    label: 'DVSA Competency Tracking',
    values: [true, false, false]
  },
  {
    label: 'Responsive Web App',
    values: [true, false, false]
  },
  {
    label: 'Customer Support',
    values: [true, false, false]
  },
  {
