        <a href={OFFER.ctaSecondary.href} class="btn border-2 border-white text-white hover:bg-white/10 text-lg px-8 py-4">{OFFER.ctaSecondary.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>
