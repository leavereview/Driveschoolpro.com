---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRICING } from '../config/offer';
import BreadcrumbsEnhanced from '../components/seo/BreadcrumbsEnhanced.astro';
import FeaturedAnswer from '../components/seo/FeaturedAnswer.astro';
import StatisticsSection from '../components/seo/StatisticsSection.astro';
import ComparisonTable from '../components/seo/ComparisonTable.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import MarketingScreenshot from '../components/MarketingScreenshot.astro';
import { OFFER } from '../config/offer';

const freeStats = [
  {
    label: 'Price today',
    value: '£0',
    context: 'Every feature, during early access'
  },
  {
    label: 'Free until',
    value: '31 Mar 2027',
    context: 'No card required to sign up'
  },
  {
    label: 'Free plan from 1 Apr 2027',
    value: '£0',
    context: `For ever: ${PRICING.free.instructors} instructor, up to ${PRICING.free.lessonsPerMonth} lessons a month`
  },
  {
    label: 'Solo plan',
    value: `£${PRICING.solo.price}`,
    context: 'A month, unlimited lessons, no VAT charged'
  },
  {
    label: 'School plan',
    value: `£${PRICING.school.price}`,
    context: `A month, plus £${PRICING.school.perExtraInstructor} per extra instructor`
  },
  {
    label: 'DVSA skills tracked',
    value: '27',
    context: 'Across 8 categories, on every plan'
  }
];

const P = PRICING;

// "How it compares" rows. Other vendors are described by type, not by name or price:
// named, dated competitor details live only on /blog/best-driving-school-software/.
const comparisonData = [
  {
    label: 'What it costs',
    values: ['£0 until 31 March 2027', '£0 for ever', '£0', 'Monthly fee after the trial', '£0'],
    highlight: true
  },
  {
    label: 'Time limit',
    values: ['Free until 31 March 2027', 'None', 'None', 'Usually 14 to 60 days', 'None']
  },
  {
    label: 'Usage limit',
    values: ['None', `${P.free.instructors} instructor, ${P.free.lessonsPerMonth} lessons a month`, 'Capped bookings each month', 'Varies', 'None']
  },
  {
    label: 'DVSA 27-skill progress tracking',
    values: [true, true, false, 'Varies', false]
  },
  {
    label: 'Automatic lesson reminders',
    values: ['Email', 'Email', 'Varies', 'Varies', false]
  },
  {
    label: 'Pupils book online',
    values: [true, true, true, 'Varies', false]
  },
  {
    label: 'Built for UK driving instructors',
    values: [true, true, false, 'Mostly', false]
  }
];

const faqItems = [
  {
    question: "Is there a free version of driving school software?",
    answer: `Yes. DriveSchoolPro is free while it's in early access, until 31 March 2027. You get every feature, for solo instructors and multi-instructor schools, with no card required. From ${P.startDate} there's a permanent Free plan for ${P.free.instructors} instructor and up to ${P.free.lessonsPerMonth} lessons a month, with every feature including AI lesson briefings.`,
    links: [
      { text: 'See pricing', url: '/pricing/' },
      { text: OFFER.ctaPrimary.labelShort, url: OFFER.ctaPrimary.href }
    ]
  },
  {
    question: "What's included in DriveSchoolPro for free?",
    answer: "Until 31 March 2027, everything: the diary with drag-and-drop rescheduling, email lesson reminders, online booking and the pupil portal, DVSA progress tracking across all 27 skills, AI lesson briefings, invoicing and payment recording, and multi-instructor accounts with vehicle tracking. There are no setup fees and no VAT.",
    links: [
      { text: 'All features', url: '/' }
    ]
  },
  {
    question: "What are the limits of the free version?",
    answer: `During early access there's no lesson or pupil limit. From ${P.startDate} the Free plan covers ${P.free.instructors} instructor and up to ${P.free.lessonsPerMonth} lessons a month, with email reminders. Cancelled lessons and no-shows don't count towards the limit. Text and WhatsApp reminders are coming soon and will be on Solo and School, because each message costs us money.`,
    links: [
      { text: 'Plan details', url: '/pricing/' }
    ]
  },
  {
    question: "What happens if I go over 60 lessons a month on the Free plan?",
    answer: "Nothing breaks and nothing is deleted. We'll let you know when you're close, and once you're regularly over the limit we'll ask you to move to Solo.",
    links: [
      { text: 'Solo and School plans', url: '/pricing/' }
    ]
  },
  {
    question: "What happens on 1 April 2027 if I do nothing?",
    answer: "Your account moves to the Free plan. Nothing is charged unless you choose Solo or School, and your pupils, lessons and progress records all stay where they are.",
    links: [
      { text: 'See pricing', url: '/pricing/' }
    ]
  },
  {
    question: "How much does DriveSchoolPro cost after the free period?",
    answer: `From ${P.startDate}: Free (£0, ${P.free.instructors} instructor, up to ${P.free.lessonsPerMonth} lessons a month), Solo at £${P.solo.price} a month, or School at £${P.school.price} a month plus £${P.school.perExtraInstructor} for each extra instructor. We're not VAT-registered, so no VAT is added. Plans are monthly with no contract. If you add a card by ${P.founding.cardBy}, you pay the founding price of £${P.founding.price} a month (School: £${P.founding.price} plus £${P.founding.perExtraInstructor} per extra instructor), locked for ${P.founding.lockMonths} months.`,
    links: [
      { text: 'Full pricing', url: '/pricing/' }
    ]
  },
  {
    question: "Are there any fees while it's free?",
    answer: `There's no subscription fee and no card needed to sign up. If you take card payments from pupils through DriveSchoolPro invoice pay-links, we charge ${P.cardFeePercent}% and Stripe's standard processing fee applies on top. Cash and bank transfers carry no fee.`,
    links: [
      { text: 'How payments work', url: '/pricing/' }
    ]
  },
  {
    question: "Is it a free trial?",
    answer: "No. A trial ends after a set number of days and then asks you to pay. DriveSchoolPro is free until 31 March 2027, and after that the Free plan stays free for as long as you're within its limits. Nothing is charged automatically, because we don't ask for a card.",
    links: [
      { text: OFFER.ctaPrimary.labelShort, url: OFFER.ctaPrimary.href }
    ]
  },
  {
    question: "How does it compare with other free options?",
    answer: "General booking tools such as SimplyBook.me and Reservio have free plans, but they cap bookings each month and don't track the DVSA driving skills. Most driving instructor apps offer a free trial rather than a free plan, usually 14 to 60 days. Our best driving school software guide lists each one, checked against the vendors' own sites.",
    links: [
      { text: 'Best driving school software UK', url: '/blog/best-driving-school-software/' },
      { text: 'Compare DriveSchoolPro', url: '/compare/' }
    ]
  },
  {
    question: "How do I switch to DriveSchoolPro?",
    answer: "Sign up with no card, set your working hours, lesson prices and reminder timing, then add your current pupils. A name and phone number is enough to start. Enter next week's lessons and keep your old diary running alongside for a couple of weeks. If you already have a pupil list, import it from a CSV file (Total Drive and MyDriveTime exports work as they are).",
    links: [
      { text: 'Switching guide', url: '/blog/switch-paper-diary-to-driving-school-software/' }
    ]
  },
  {
    question: "Can I get my data out if I leave?",
    answer: "Yes. The account owner can download a copy of everything held for the school from Settings, then Profile: pupil records, lesson history, payments and skill records. It's a JSON file, so it's a complete record rather than a spreadsheet ready to load into another product.",
    links: [
      { text: 'Privacy policy', url: '/privacy-policy/' }
    ]
  },
  {
    question: "Is there a free driving instructor app?",
    answer: "Yes. DriveSchoolPro is free on the App Store and Google Play, and works in a web browser too. You run your diary from the app, and your pupils use the same app, or any browser, to see their lessons and progress, book and pay.",
    links: [
      { text: 'DriveSchoolPro for driving instructors', url: '/driving-instructor-software/' }
    ]
  },
  {
    question: "Is my data safe on free software?",
    answer: "DriveSchoolPro is run by JOHN POWELL LTD, a UK company: the data controller for your account, and your processor for the pupil records you add. Your data is encrypted at rest, and payments are handled by Stripe (PCI DSS Level 1). Lesson briefings are written by Claude (Anthropic), and your data is not used to train any AI model.",
    links: [
      { text: 'Privacy policy', url: '/privacy-policy/' }
    ]
  }
];

const schemaMarkup = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Free Driving School Software: What's Free, the Limits and How to Switch",
  "description": "What the free version of DriveSchoolPro includes today, the Free plan limits from 1 April 2027, how it compares with free plans and trials, and how to switch.",
  "author": {
    "@type": "Organization",
    "name": "DriveSchoolPro"
  },
  "publisher": {
    "@type": "Organization",
    "name": "DriveSchoolPro"
  },
  "datePublished": "2026-01-18",
  "dateModified": "2026-01-18"
};
---

<BaseLayout
  title="Free Driving School Software UK: What's Free and the Limits"
  description="DriveSchoolPro's free version: every feature free until 31 March 2027, then a Free plan for 1 instructor and 60 lessons a month. Limits and switching."
  image="/images/marketing/dashboard-overview.webp"
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaMarkup)} />

  <!-- Breadcrumbs with Schema -->
  <BreadcrumbsEnhanced
    site="driveschool"
    items={[
      { label: 'Home', href: '/' },
      { label: 'Free Driving School Software', href: '/free-driving-school-software/' }
    ]}
  />

  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy to-gray-900 text-white py-16">
    <div class="container-custom relative">
      <div class="max-w-3xl">
        <span class="inline-block px-4 py-1 bg-brand-red/20 text-brand-red-light rounded-full text-sm font-medium mb-4">Free Software Guide</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Free Driving School Software: What's Actually Available?</h1>
        <p class="text-xl text-gray-300 mb-8">
          DriveSchoolPro is free while we're in early access, until 31 March 2027: every feature, no card required. After that there's a permanent Free plan for {P.free.instructors} instructor and up to {P.free.lessonsPerMonth} lessons a month. This page sets out what's free, the limits, how it compares and how to switch.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={OFFER.ctaPrimary.href} class="btn-primary text-lg px-8 py-4">{OFFER.ctaPrimary.label}</a>
          <a href="#compare" class="btn-secondary text-lg px-8 py-4">Compare Options</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Answer -->
  <FeaturedAnswer question="Is there a free version of driving school software?">
    Yes. DriveSchoolPro is free until 31 March 2027 while it's in early access, with every feature and no card required. From 1 April 2027 there's a permanent Free plan for {P.free.instructors} instructor and up to {P.free.lessonsPerMonth} lessons a month, Solo at £{P.solo.price} a month, and School at £{P.school.price} a month plus £{P.school.perExtraInstructor} per extra instructor. No VAT is charged.
  </FeaturedAnswer>

  <!-- Key facts -->
  <StatisticsSection
    site="driveschool"
    pageUrl="https://driveschoolpro.com/free-driving-school-software/"
    title="DriveSchoolPro pricing at a glance"
    stats={freeStats}
  />

  <!-- Table of Contents -->
  <section class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-brand-navy mb-4">In This Guide</h2>
        <nav class="bg-white rounded-xl p-6 shadow-sm">
          <ul class="grid md:grid-cols-2 gap-3">
            <li><a href="#whats-free" class="text-brand-red hover:underline">What's free today</a></li>
            <li><a href="#limits" class="text-brand-red hover:underline">The limits</a></li>
            <li><a href="#plans" class="text-brand-red hover:underline">Plans from 1 April 2027</a></li>
            <li><a href="#compare" class="text-brand-red hover:underline">How it compares</a></li>
            <li><a href="#switch" class="text-brand-red hover:underline">How to switch</a></li>
            <li><a href="#faqs" class="text-brand-red hover:underline">FAQs</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">

        <!-- What's free today -->
        <div id="whats-free" class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">What's free today</h2>
          <p class="text-gray-600 mb-6">
            Until 31 March 2027, DriveSchoolPro is free for every instructor and every school, whatever the size. It isn't a cut-down tier: everyone gets the whole product, with unlimited pupils and lessons. You don't need a card to sign up, there are no setup fees, and we're not VAT-registered, so nothing is added on top.
          </p>
          <div class="grid md:grid-cols-2 gap-4">
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">Diary and scheduling</h3>
              <p class="text-gray-600 text-sm">Day, week and month views, with drag-and-drop rescheduling and one diary view across your team.</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">Email lesson reminders</h3>
              <p class="text-gray-600 text-sm">Sent automatically, with timing you choose, per-pupil preferences and a delivery log.</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">Online booking and pupil portal</h3>
              <p class="text-gray-600 text-sm">Pupils book from a widget on your website, and log in to see their lessons, progress and package balance.</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">DVSA progress tracking</h3>
              <p class="text-gray-600 text-sm">All <a href="/dvsa-27-driving-skills/" class="text-brand-red hover:underline">27 DVSA skills</a> across 8 categories, on a 6-level scale from Not Started to Reflection.</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">AI lesson briefings</h3>
              <p class="text-gray-600 text-sm">A short briefing for each lesson, written from your own lesson notes.</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">Invoices and payments</h3>
              <p class="text-gray-600 text-sm">Record cash, bank transfer and cheque payments, and send invoices with Stripe card pay-links.</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">Multi-instructor schools</h3>
              <p class="text-gray-600 text-sm">Add instructors with role-based access, and track your vehicles.</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-5">
              <h3 class="font-bold text-brand-navy mb-2">Phone apps and web</h3>
              <p class="text-gray-600 text-sm">Free on the App Store and Google Play, and the same account works in any web browser.</p>
            </div>
          </div>

          <div class="my-10">
            <MarketingScreenshot
              src="/images/marketing/dashboard-overview.webp"
              width={1440}
              height={900}
              alt="DriveSchoolPro Today screen showing the day's lessons per instructor and the day's lesson value"
            />
            <p class="text-sm text-gray-500 text-center mt-3">The DriveSchoolPro Today screen, included free</p>
          </div>
        </div>

        <!-- The limits -->
        <div id="limits" class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">The limits</h2>
          <p class="text-gray-600 mb-6">
            Free software is only useful if you know where it stops. Here's what to know, now and after 31 March 2027.
          </p>

          <h3 class="text-xl font-bold text-brand-navy mb-3">During early access (until 31 March 2027)</h3>
          <ul class="space-y-3 mb-8">
            <li class="border-l-4 border-amber-500 pl-4 py-1 text-gray-700"><strong>Card payments carry a fee.</strong> If pupils pay by card through DriveSchoolPro, we charge {P.cardFeePercent}%, and Stripe's standard processing fee applies on top. Cash and bank transfers carry no fee.</li>
            <li class="border-l-4 border-amber-500 pl-4 py-1 text-gray-700"><strong>Reminders are email only for now.</strong> Text and WhatsApp reminders are coming soon.</li>
            <li class="border-l-4 border-amber-500 pl-4 py-1 text-gray-700"><strong>Some features are still on the way.</strong> Recurring lesson series are coming soon. Test bookings, test results and pass-rate reporting are coming soon too.</li>
            <li class="border-l-4 border-amber-500 pl-4 py-1 text-gray-700"><strong>Pupils only on import.</strong> You can import your pupil list from a CSV file, but lesson history and payments don't come across.</li>
          </ul>

          <h3 class="text-xl font-bold text-brand-navy mb-3">On the Free plan (from 1 April 2027)</h3>
          <ul class="space-y-3">
            <li class="border-l-4 border-amber-500 pl-4 py-1 text-gray-700"><strong>{P.free.instructors} instructor.</strong> Schools with more instructors use the School plan.</li>
            <li class="border-l-4 border-amber-500 pl-4 py-1 text-gray-700"><strong>Up to {P.free.lessonsPerMonth} lessons a month.</strong> Cancelled lessons and no-shows don't count. If you go over, nothing breaks and nothing is deleted; once you're regularly over, we'll ask you to move to Solo.</li>
            <li class="border-l-4 border-amber-500 pl-4 py-1 text-gray-700"><strong>Email reminders.</strong> Text and WhatsApp reminders, when they launch, will be on Solo and School, because each message costs us money.</li>
            <li class="border-l-4 border-green-500 pl-4 py-1 text-gray-700"><strong>Every feature otherwise.</strong> Online booking, invoicing, the pupil portal, DVSA tracking and AI lesson briefings are all on the Free plan.</li>
          </ul>
        </div>

        <!-- Plans from 1 April 2027 -->
        <div id="plans" class="mb-16">
          <h2 class="text-3xl font-bold text-brand-navy mb-6">Plans from 1 April 2027</h2>
          <p class="text-gray-600 mb-6">
            Prices are per month, with no contract. We're not VAT-registered, so the price you see is the price you pay.
          </p>
          <div class="overflow-x-auto mb-6">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-brand-navy text-white">
                  <th scope="col" class="p-3 text-left">Plan</th>
                  <th scope="col" class="p-3 text-left">Price</th>
                  <th scope="col" class="p-3 text-left">Who it's for</th>
                  <th scope="col" class="p-3 text-left">What you get</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr>
                  <th scope="row" class="p-3 text-left font-bold text-brand-navy">Free</th>
                  <td class="p-3">£0, for ever</td>
                  <td class="p-3">Part-time and new instructors</td>
                  <td class="p-3">{P.free.instructors} instructor, up to {P.free.lessonsPerMonth} lessons a month, every feature including AI lesson briefings, email reminders</td>
                </tr>
                <tr class="bg-gray-50">
                  <th scope="row" class="p-3 text-left font-bold text-brand-navy">Solo</th>
                  <td class="p-3">£{P.solo.price} a month</td>
                  <td class="p-3">Full-time independent ADIs</td>
                  <td class="p-3">1 instructor, unlimited lessons, every feature, text and WhatsApp reminders (coming soon)</td>
                </tr>
                <tr>
                  <th scope="row" class="p-3 text-left font-bold text-brand-navy">School</th>
                  <td class="p-3">£{P.school.price} a month + £{P.school.perExtraInstructor} per extra instructor</td>
                  <td class="p-3">Multi-instructor schools</td>
                  <td class="p-3">Everything in Solo, plus role-based access, vehicle tracking and one diary view across the team</td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="bg-brand-red-light rounded-xl p-6">
            <h3 class="font-bold text-brand-navy mb-2">Founding member price</h3>
            <p class="text-gray-700 text-sm">
              Add a card by {P.founding.cardBy} and pay £{P.founding.price} a month instead of £{P.solo.price} (School: £{P.founding.price} + £{P.founding.perExtraInstructor} per extra instructor), locked for {P.founding.lockMonths} months from {P.startDate}. Nothing is charged before {P.startDate}, and you can cancel before then. If you do nothing, your account simply moves to the Free plan, and your pupils, lessons and progress records stay where they are.
            </p>
          </div>
          <p class="text-gray-600 mt-4 text-sm">Full details are on the <a href="/pricing/" class="text-brand-red hover:underline">pricing page</a>.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- How it compares -->
  <section id="compare" class="section bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto mb-8">
        <h2 class="text-3xl font-bold text-brand-navy mb-4">How it compares</h2>
        <p class="text-gray-600 mb-4">
          "Free" covers four quite different things. Free plans from general booking tools, such as SimplyBook.me and Reservio, are permanent but cap your bookings each month, and they aren't built for driving lessons, so there's no DVSA progress tracking. Most driving instructor apps offer a free trial instead, usually 14 to 60 days, and then charge a monthly fee. Spreadsheets and a paper diary cost nothing, but they can't remind pupils or let them book.
        </p>
        <p class="text-gray-600">
          For named apps, with their trials and published prices checked against each vendor's own site, see our guide to the <a href="/blog/best-driving-school-software/" class="text-brand-red hover:underline">best driving school software in the UK</a>, or the side-by-side <a href="/compare/" class="text-brand-red hover:underline">comparison pages</a>.
        </p>
      </div>
      <ComparisonTable
        title="DriveSchoolPro free vs other free options"
        headers={['DriveSchoolPro (until 31 Mar 2027)', 'DriveSchoolPro Free plan (from 1 Apr 2027)', 'General booking tools (free plans)', 'Instructor apps (free trials)', 'Spreadsheet or paper diary']}
        rows={comparisonData}
      />
    </div>
  </section>

  <!-- How to switch -->
  <section id="switch" class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-brand-navy mb-6">How to switch</h2>
        <p class="text-gray-600 mb-6">
          Whether you're moving from paper, WhatsApp, a spreadsheet or another app, the safe way is to run both side by side for a couple of weeks.
        </p>
        <ol class="space-y-4">
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 w-8 h-8 bg-brand-red text-white rounded-full flex items-center justify-center font-bold">1</div>
            <div>
              <strong class="text-brand-navy">Sign up free</strong>
              <p class="text-gray-600 text-sm">No card needed. Setting up takes about two minutes.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 w-8 h-8 bg-brand-red text-white rounded-full flex items-center justify-center font-bold">2</div>
            <div>
              <strong class="text-brand-navy">Set your basics</strong>
              <p class="text-gray-600 text-sm">Your working days and hours, lesson prices and when reminders go out.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 w-8 h-8 bg-brand-red text-white rounded-full flex items-center justify-center font-bold">3</div>
            <div>
              <strong class="text-brand-navy">Add your current pupils</strong>
              <p class="text-gray-600 text-sm">Import them from a CSV file (Total Drive and MyDriveTime exports work as they are), or add them one at a time: a name and phone number is enough to start; add progress levels and test dates as you go. You don't need to type in old lesson history.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 w-8 h-8 bg-brand-red text-white rounded-full flex items-center justify-center font-bold">4</div>
            <div>
              <strong class="text-brand-navy">Enter next week's lessons</strong>
              <p class="text-gray-600 text-sm">Then reminders go out automatically, and you can log DVSA skills after each lesson.</p>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="flex-shrink-0 w-8 h-8 bg-brand-red text-white rounded-full flex items-center justify-center font-bold">5</div>
            <div>
              <strong class="text-brand-navy">Keep your old system for a couple of weeks</strong>
