---
// Sub-processor list referenced by the Data Processing Terms (clause 6) and the privacy policy.
// Content lives in src/config/subprocessors.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SubprocessorCard from '../components/SubprocessorCard.astro';
import { SUBPROCESSORS, SUBPROCESSORS_UPDATED, SUBPROCESSORS_CHANGELOG } from '../config/subprocessors';

const pupil = SUBPROCESSORS.filter((s) => s.section === 'pupil');
const limited = SUBPROCESSORS.filter((s) => s.section === 'limited');
const own = SUBPROCESSORS.filter((s) => s.section === 'own');
const website = SUBPROCESSORS.filter((s) => s.section === 'website');
---

<BaseLayout
  title="Sub-processors"
  description="Every company that processes personal data for DriveSchoolPro: what each does, the data it gets, where it is, and how transfers outside the UK are protected."
  modifiedDate="2026-11-24"
>
  <div class="bg-gray-100 py-3">
    <div class="container-custom">
      <Breadcrumbs items={[
        { label: 'Home', href: '/' },
        { label: 'Sub-processors' }
      ]} />
    </div>
  </div>

  <section class="section bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold text-brand-navy mb-4">Sub-processors</h1>
        <p class="text-sm text-gray-500 mb-8">Last updated: {SUBPROCESSORS_UPDATED} · <a href="#change-log" class="underline">Change log</a></p>
        <div class="prose max-w-none">

<p>DriveSchoolPro is run by JOHN POWELL LTD (company number 05408918, registered office 124 City Road, London, England, EC1V 2NX).</p>

<p>For pupil records, the driving school or instructor is the controller and we are their processor. The companies in sections A and B help us process that data and are our sub-processors under our <a href="/data-processing-terms/">Data Processing Terms</a>. Section C lists the companies that only handle our own data (account owners, website visitors, our marketing). Section D lists the companies that only run this website.</p>

<p>If we want to add a sub-processor to section A or B, we email account owners at least 30 days before it starts. You can object, and the Data Processing Terms say what happens next. We list every change in the <a href="#change-log">change log</a> at the bottom.</p>

<p>Questions: <a href="mailto:privacy@driveschoolpro.com">privacy@driveschoolpro.com</a>.</p>

<h2 id="pupil-data">A. Sub-processors that can receive pupil personal data</h2>
        </div>

        <div class="space-y-4 mt-4">
          {pupil.map((s) => <SubprocessorCard s={s} />)}
        </div>

        <div class="prose max-w-none mt-10">
<h2 id="limited">B. Other providers that may touch pupil-side data in limited ways</h2>
        </div>

        <div class="space-y-4 mt-4">
          {limited.map((s) => <SubprocessorCard s={s} />)}
        </div>

        <div class="prose max-w-none mt-10">
<h2 id="our-own-data">C. Companies that handle our own data (account owners and visitors), where we are the controller</h2>
<div class="overflow-x-auto">
<table>
  <thead><tr><th>Company</th><th>Purpose</th><th>Data</th><th>Where</th><th>Terms</th></tr></thead>
  <tbody>
    {own.map((s) => (
      <tr>
        <td><strong>{s.name}</strong>{s.entity && <><br /><span class="text-gray-500">{s.entity}</span></>}</td>
        <td>{s.purpose}</td>
        <td>{s.data}</td>
        <td>{s.where}</td>
        <td>{s.terms ? <a href={s.terms.href} target="_blank" rel="noopener noreferrer">{s.terms.label}</a> : 'None published that we could find'}</td>
      </tr>
    ))}
  </tbody>
</table>
</div>

<h2 id="website">D. Companies that run this website only (driveschoolpro.com)</h2>
<div class="overflow-x-auto">
<table>
  <thead><tr><th>Company</th><th>Purpose</th><th>Where</th><th>Terms</th></tr></thead>
  <tbody>
    {website.map((s) => (
      <tr>
        <td><strong>{s.name}</strong>{s.entity && <><br /><span class="text-gray-500">{s.entity}</span></>}</td>
        <td>{s.purpose}</td>
        <td>{s.where}</td>
        <td>{s.terms ? <a href={s.terms.href} target="_blank" rel="noopener noreferrer">{s.terms.label}</a> : 'None published that we could find'}</td>
      </tr>
    ))}
  </tbody>
</table>
</div>

<h2 id="transfers">How transfers outside the UK are protected</h2>
<p>Where a company processes personal data outside the UK, we rely on one of: UK adequacy regulations (for countries such as those in the EEA), the UK Extension to the EU-US Data Privacy Framework (for certified US companies), or the UK International Data Transfer Addendum or Agreement with the provider. The "Transfer protection" entries show what each provider's own terms say. Ask <a href="mailto:privacy@driveschoolpro.com">privacy@driveschoolpro.com</a> for details for any provider.</p>

<h2 id="change-log">Change log</h2>
<div class="overflow-x-auto">
<table>
  <thead><tr><th>Date</th><th>Change</th></tr></thead>
  <tbody>
    {SUBPROCESSORS_CHANGELOG.map((c) => (
      <tr><td class="whitespace-nowrap">{c.date}</td><td>{c.change}</td></tr>
    ))}
  </tbody>
</table>
</div>

<p>See also our <a href="/privacy-policy/">Privacy Policy</a>, <a href="/data-processing-terms/">Data Processing Terms</a> and <a href="/terms/">Terms of Service</a>.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
