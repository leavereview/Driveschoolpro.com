---
// /become-a-driving-instructor/adi-part-1/ (issue #85). No question-bank content: DVSA's is licensed.
import InstructorGuideLayout from '../../components/guide/InstructorGuideLayout.astro';
import { FEES, GOVUK } from '../../data/instructor-guide';

const faqs = [
  {
    question: 'What is the ADI part 1 test?',
    answer: 'ADI part 1 is the first of the three qualifying tests for approved driving instructors. It is a theory test in two parts, multiple-choice questions and a hazard perception video test, booked and taken as a single test. You must pass both parts to pass.',
  },
  {
    question: 'What is the pass mark for ADI part 1?',
    answer: 'For the multiple-choice part you need at least 85 out of 100 overall and at least 20 out of 25 in each of the 4 question categories. For hazard perception you need at least 57 out of 75. If you reach 85 overall but fall short in one category you still fail that part.',
  },
  {
    question: 'How many questions are in the ADI theory test?',
    answer: 'There are 100 multiple-choice questions, 25 in each of 4 categories, and you have 1 hour and 30 minutes. The hazard perception part has 14 video clips.',
  },
  {
    question: 'How many times can I take ADI part 1?',
    answer: 'The ADI register guide lists unlimited attempts for part 1. You must wait at least 3 working days between tests, and every attempt costs the full fee. The 2-year clock to pass the other parts starts when you pass part 1.',
  },
  {
    question: 'How much does the ADI part 1 test cost?',
    answer: `The test costs £${FEES.part1}. You can book once your application to start the ADI qualifying process has been accepted.`,
  },
  {
    question: 'What do I take to the ADI theory test?',
    answer: 'You must take your UK photocard driving licence. If you have a paper licence you need a valid passport as well, and a Northern Ireland licence needs the paper counterpart. If you do not bring the right items your test will be cancelled and you will not get your money back.',
  },
  {
    question: 'Can I use a question bank to revise?',
    answer: 'GOV.UK says you can use books and software to revise and lists the sources the questions are based on, and it points to DVSA\'s official theory test kit e-Learning for ADIs. We do not reproduce any question bank on this site, because DVSA\'s is licensed.',
  },
];

const sources = [
  GOVUK.part1,
  GOVUK.part1Mcq,
  GOVUK.part1Hpt,
  GOVUK.part1Pass,
  GOVUK.part1Revision,
  GOVUK.part1Take,
