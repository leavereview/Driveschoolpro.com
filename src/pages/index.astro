    class="md:hidden fixed bottom-0 left-0 right-0 z-40 py-4 text-center font-semibold text-white text-base bg-brand-red translate-y-full transition-transform duration-300"
    aria-label={OFFER.ctaPrimary.label}
  >
    {OFFER.ctaPrimary.labelShort}
  </a>

  <script>
    (function () {
      const hero = document.getElementById('hero-section');
      const cta  = document.getElementById('sticky-mobile-cta') as HTMLAnchorElement | null;
      if (!hero || !cta) return;

      // Keep the CTA above the cookie banner when it is visible
      function updateBottomOffset(): void {
        const banner = document.getElementById('cookie-consent');
        if (banner && !localStorage.getItem('dsp-cookie-consent')) {
          cta!.style.bottom = banner.offsetHeight + 'px';
        } else {
          cta!.style.bottom = '';
        }
      }

      // Show CTA once hero scrolls out of view; hide it when hero is visible
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            cta.classList.add('translate-y-full');
          } else {
            cta.classList.remove('translate-y-full');
            updateBottomOffset();
          }
        },
        { threshold: 0 }
      );
      observer.observe(hero);

      // Reset bottom offset once user responds to cookie banner
      (['cookieConsentAccepted', 'cookieConsentRejected'] as const).forEach((evt) => {
        window.addEventListener(evt, () => { cta!.style.bottom = ''; });
      });
    })();
  </script>
