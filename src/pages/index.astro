---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductDemo from '../components/ProductDemo.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQEnhanced from '../components/seo/FAQEnhanced.astro';
import { OFFER } from '../config/offer';

// SoftwareApplication Schema
const softwareApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": "https://driveschoolpro.com/#software",
  "name": "DriveSchoolPro",
  "alternateName": "DriveSchoolPro",
  "description": "Complete driving school management software for driving instructors and schools. Lesson scheduling, student management, automated billing, and instructor allocation in one platform.",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "offers": [
    {
      "@type": "Offer",
      "@id": "https://driveschoolpro.com/#early-access",
      "name": "Early Access — Free until 31 March 2027",
      "description": "DriveSchoolPro is free during early access — until 31 March 2027. Unlimited students, DVSA progress tracking, scheduling, and invoicing. No card required.",
      "price": "0",
      "priceCurrency": "GBP",
      "availability": "https://schema.org/InStock",
      "url": OFFER.ctaPrimary.href,
      "priceValidUntil": "2027-03-31"
    }
  ],
  "featureList": [
    "Lesson Scheduling with Conflict Detection",
    "Student Management",
    "Instructor Allocation",
    "Vehicle Compliance Tracking",
    "Invoicing & Payment Recording",
    "DVSA Competency Framework",
    "Automated Email Reminders",
    "Student Self-Service Portal",
    "Embeddable Booking Widget",
    "Card Payments via Stripe",
    "Offline Access",
    "Installable Mobile App",
    "Reports & Analytics",
    "Role-Based Access Control"
  ],
  "url": "https://driveschoolpro.com",
  "screenshot": "https://driveschoolpro.com/images/marketing/dashboard-overview.webp",
  "softwareVersion": "2.0",
  "applicationSubCategory": "Driving School Management",
  "audience": {
    "@type": "BusinessAudience",
    "audienceType": "Driving Schools, Driving Instructors, ADI Training Schools"
  }
};

const features = [
  {
    icon: 'calendar',
    title: 'Smart Scheduling',
    description: 'Day, week and month calendar views with colour-coded lessons across every instructor. Three-way conflict detection checks student, instructor, and vehicle before every booking. Drag-and-drop rescheduling and quick booking straight from the calendar.'
  },
  {
    icon: 'users',
    title: 'Student Management',
    description: 'Complete student profiles with DVSA competency tracking across all 27 skills, per-student notification preferences, and every student\'s balance tracked with a full credit and debit ledger.'
  },
  {
    icon: 'bell',
    title: 'Automated Reminders',
    description: 'Automated email reminders with configurable timing, sent before every lesson to cut no-shows. (WhatsApp coming soon.)'
  },
  {
    icon: 'chart',
    title: 'Business Analytics',
    description: 'Real-time dashboard with 8 business metrics. Financial reports with 6-month revenue trends, lesson and vehicle reporting, and student progress overviews.'
  }
];


const stats = [
  { number: 'Unlimited', label: 'Students & Lessons' },
  { number: 'Built for', label: 'UK ADIs' },
  { number: '10+ hrs', label: 'Saved Weekly*' },
  { number: '27', label: 'DVSA Skills Tracked' }
];

// Homepage FAQ — answers kept strictly to what the product does (FAQ schema auto-generated)
const homeFaqs = [
  {
    question: "Do I need a credit card to start?",
    answer: "No. DriveSchoolPro is free while we're in early access — until 31 March 2027 — and there's no card required. Just sign up and start using it.",
  },
  {
    question: "Can I cancel anytime? Is there a contract?",
    answer: "Yes, you can cancel anytime. Plans are month-to-month with no long-term contract and no cancellation fees — cancel before your next billing date and you won't be charged again.",
  },
  {
    question: "How is my data kept secure, and where is it hosted?",
    answer: "DriveSchoolPro is run by LEAVE.REVIEW LTD, a UK company and the data controller under UK GDPR. Payments are handled by Stripe (PCI DSS Level 1) and your data is encrypted at rest. Our sub-processors are Stripe, Neon, Vercel and Resend.",
    links: [{ text: "Privacy policy", url: "/privacy-policy/" }],
  },
  {
    question: "Is my data used to train AI?",
    answer: "No. Lesson briefings are generated by Claude (Anthropic). Your data is sent securely to produce each briefing and is not used to train any AI model.",
    links: [{ text: "How AI briefings work", url: "/how-progress-works/" }],
  },
  {
    question: "I'm moving from a paper diary, WhatsApp or a spreadsheet — is it hard to switch?",
    answer: "Not at all. Most instructors are set up in about five minutes, and you can keep your current diary running alongside until you're confident. DriveSchoolPro is free during early access — no card required.",
    links: [{ text: "Switching guide", url: "/blog/switch-paper-diary-to-driving-school-software/" }],
  },
  {
    question: "How much does DriveSchoolPro cost?",
    answer: "Nothing right now. DriveSchoolPro is free while we're in early access — until 31 March 2027 — for solo instructors and multi-instructor schools alike. Pricing will be announced well before 1 April 2027, and nothing is ever charged automatically.",
    links: [{ text: "See full pricing", url: "/pricing/" }],
  },
  {
    question: "Which reminders can I send — email or WhatsApp?",
    answer: "Reminders go out by email automatically before every lesson, with configurable timing and full delivery logs. WhatsApp is coming soon.",
  },
  {
    question: "What if I want to stop?",
    answer: "You can stop anytime. DriveSchoolPro is free until 31 March 2027 with no card on file, so there's nothing to refund — close your account whenever you like and you'll never be charged automatically.",
  },
];
---

<BaseLayout title="DriveSchoolPro | Driving School Software for UK ADIs" description={`DVSA progress tracking, three-way scheduling, and automated reminders. Purpose-built for UK driving schools. ${OFFER.long}.`} image="/images/marketing/dashboard-overview.webp">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} />
  </Fragment>

  <!-- Hero -->  <!-- (announcement banner now rendered site-wide via PromoBanner in BaseLayout) -->
  <section id="hero-section" class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-navy to-gray-900 text-white">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: url('/images/hero-driving.jpg'); background-size: cover; background-position: center;"></div>
    </div>
    <div class="container-custom relative py-20 md:py-32">
      <div class="max-w-3xl">
        <span class="badge-primary mb-6">Purpose-built for UK driving instructors</span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6">
          Teach. <span class="text-brand-red">Everything else runs itself.</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
          Pupils book and pay on their phones. Lesson briefings write themselves. The reviews
          you keep meaning to ask for actually get asked. You get in the car and teach.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href={OFFER.ctaPrimary.href} class="btn-primary text-lg px-8 py-4">{OFFER.ctaPrimary.label} →</a>
          <a href="#the-week" class="btn-secondary text-lg px-8 py-4">See it work</a>
        </div>
        <p class="mt-6 text-sm text-gray-400">No credit card required • {OFFER.short}</p>
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="bg-white border-b border-gray-100 py-4">
    <div class="container-custom">
      <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm font-medium text-gray-700">
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          UK GDPR compliant
        </li>
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          Stripe-secured payments
        </li>
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
          No card to start
        </li>
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Cancel anytime
        </li>
        <li class="flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-red flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          Built for UK ADIs
        </li>
      </ul>
    </div>
  </section>

  <!-- Stats bar -->
  <section class="py-12 bg-gray-50 border-b border-gray-100">
    <div class="container-custom">
      <p class="text-center text-sm text-gray-500 uppercase tracking-wider mb-8">Built to scale with your school</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {stats.map((stat) => (
          <div>
            <div class="text-3xl md:text-4xl font-bold text-brand-navy">{stat.number}</div>
            <div class="text-sm text-gray-600 mt-1">{stat.label}</div>
          </div>
        ))}
      </div>
      <p class="text-center text-xs text-gray-400 mt-6">*Based on early user feedback comparing admin time before and after adoption.</p>
    </div>
  </section>

  <!-- §3 Scheduling — Sunday night -->
  <section id="the-week" class="section bg-white border-t border-gray-100 scroll-mt-20">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-lg text-gray-500 italic mb-4">
            Sunday night, kitchen table, three pupils to move and a diary full of pencil marks.
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-6">
            Move a lesson. Everything else catches up.
          </h2>
          <p class="text-lg text-gray-600 mb-6">
            Drag it and it's done. Three-way conflict checking means you can't double-book a
            pupil, an instructor, or a car. Day, week and month views — the month view shows
            you where the gaps are.
          </p>
          <a href="/features/scheduling/" class="text-brand-red font-semibold hover:underline">
            See how scheduling works &rarr;
          </a>
        </div>
        <div>
          <ProductDemo
            poster="/images/marketing/calendar-week-view.webp"
            width={1440}
            height={900}
            alt="A lesson is dragged from Tuesday to Thursday in the weekly calendar; a second drag onto a clashing slot raises a conflict warning."
            posterAlt="A weekly calendar showing colour-coded lessons across several instructors, with booking, cancellation and utilisation totals along the top."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- §4 AI lesson briefings — the morning -->
  <section id="know-what-to-teach" class="section bg-gray-50 border-t border-gray-100 scroll-mt-20">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <ProductDemo
            poster="/images/marketing/ai-briefing-mobile.webp"
            width={640}
            height={1308}
            alt="A lesson card is opened and its AI briefing is already written: what was covered last time, what the pupil struggled with, and what to focus on today."
            posterAlt="DriveSchoolPro on a phone: the Today view showing a 15:00 lesson with a suggested focus of Manoeuvres and an AI lesson briefing on roundabout lane discipline."
            phone
          />
        </div>
        <div class="order-1 lg:order-2">
          <span class="badge-primary mb-4">AI · BUILT IN</span>
          <p class="text-lg text-gray-500 italic mb-4">
            You pull up outside their house trying to remember what went wrong at that
            roundabout three weeks ago.
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-6">
            Know exactly what to teach before you pull up.
          </h2>
          <p class="text-lg text-gray-600 mb-6">
            Open the lesson and the briefing is already written: what you covered, what they
            struggled with, what to work on today. Four sentences, ten seconds to read.
            Written by Claude — and your data is never used to train it.
          </p>
          <a href="/features/lesson-briefings/" class="text-brand-red font-semibold hover:underline">
            See how briefings work &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- §5 Progress tracking — in the car -->
  <section id="log-the-lesson" class="section bg-white border-t border-gray-100 scroll-mt-20">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-lg text-gray-500 italic mb-4">
            Notes get written up at eleven at night, or they don't get written up at all.
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-6">
            Logged before they've shut the door.
          </h2>
          <p class="text-lg text-gray-600 mb-6">
            Tap the skill, set the level, done. 27 DVSA competencies across 8 categories, six
            levels from Not Started to Reflection. Any instructor picks up exactly where the
            last one left off — and pupils can see their own progress in their portal, so they
            stop asking how they're doing.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/features/progress-tracking/" class="text-brand-red font-semibold hover:underline">
              See how progress tracking works &rarr;
            </a>
            <a href="/dvsa-27-driving-skills/" class="text-gray-500 hover:text-brand-red hover:underline transition-colors">
              Explore the 27 DVSA skills &rarr;
            </a>
          </div>
        </div>
        <div>
          <ProductDemo
            poster="/images/marketing/dvsa-progress-tracking.webp"
            width={1440}
            height={900}
            alt="A single DVSA competency is tapped in the progress grid and its proficiency level is set; the grid cell updates immediately."
            posterAlt="The DVSA competency grid showing 8 skill categories with proficiency levels from Not Started to Reflection."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- §6 Packages and pre-payment — the pupil's phone -->
  <section id="paid-before-they-turn-up" class="section bg-brand-navy text-white scroll-mt-20">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1">
          <ProductDemo
            poster="/images/marketing/portal-dashboard-mobile.webp"
            width={640}
            height={1308}
            alt="A pupil opens the package catalogue on their phone, buys a ten-lesson block by card, and books their first slots."
            posterAlt="A pupil's student portal on a phone showing their next lesson, competencies covered, test readiness and remaining package hours."
            phone
          />
        </div>
        <div class="order-1 lg:order-2">
          <span class="badge-primary mb-4">WHAT YOUR PUPILS SEE</span>
          <p class="text-lg text-gray-300 italic mb-4">
            Asking a 17-year-old for £35 at the kerb, in the rain, is nobody's favourite part
            of this job.
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mb-6">
            They've already paid before they open the door.
          </h2>
          <p class="text-lg text-gray-300 mb-6">
            Pupils browse your blocks in their own portal, pay by card through Stripe, and the
            balance keeps itself up to date. Anything still outstanding gets a payment link
            they can tap without logging in. Someone who's paid for ten lessons doesn't cancel
            on a Sunday night.
          </p>
          <a href="/features/getting-paid/" class="text-white font-semibold underline hover:text-brand-red transition-colors">
            See how getting paid works &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- §7 Review collection — end of month -->
  <section id="get-found" class="section bg-white border-t border-gray-100 scroll-mt-20">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-lg text-gray-500 italic mb-4">
            Word of mouth got you every pupil you've ever had. It just doesn't scale.
          </p>
          <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-6">
            The reviews you meant to ask for, actually asked for.
          </h2>
          <p class="text-lg text-gray-600 mb-6">
            Pupils who have just passed — and pupils who have gone quiet — appear on your
            Today screen with a Google review request ready to send. One tap, on the day they
            are happiest to write one.
          </p>
          <a href="/features/reviews/" class="text-brand-red font-semibold hover:underline">
            See how reviews work &rarr;
          </a>
        </div>
        <div>
          <ProductDemo
            poster="/images/marketing/dashboard-overview.webp"
            width={1440}
            height={900}
            alt="A pupil who has just passed appears in the review nudge panel on the Today screen, and a Google review request is sent to them in one tap."
            posterAlt="The DriveSchoolPro dashboard overview showing the day's lessons and business metrics."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Everything You Need — 4 feature cards -->
  <section class="section bg-white border-t border-gray-100">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="badge-primary mb-4">Features</span>
        <h2 class="text-3xl md:text-5xl font-bold text-brand-navy mb-6">Everything You Need to Run Your Driving School</h2>
        <p class="text-xl text-gray-600">
          From your first pupil to a multi-car school — one instructor or fifteen, the same
          tools, priced the same. <a href="/driving-school-management-software/" class="text-brand-red font-semibold hover:underline">See how it scales &rarr;</a>
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {features.map((feature) => (
          <div class="card group">
            <div class="w-12 h-12 rounded-xl bg-brand-red-light flex items-center justify-center mb-4 group-hover:bg-brand-red transition-colors">
              <svg class="w-6 h-6 text-brand-red group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                {feature.icon === 'calendar' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />}
                {feature.icon === 'users' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />}
                {feature.icon === 'chart' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />}
                {feature.icon === 'bell' && <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />}
              </svg>
            </div>
            <h3 class="text-xl font-bold text-brand-navy mb-2">{feature.title}</h3>
            <p class="text-gray-600">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <!-- Switching reassurance -->
  <section class="section bg-white border-t border-gray-100">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <span class="badge-primary mb-4">Switching is easy</span>
        <h2 class="text-3xl md:text-4xl font-bold text-brand-navy mb-4">Coming from a paper diary, WhatsApp, or a spreadsheet?</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">Moving to DriveSchoolPro is designed to be painless. Start in minutes and switch at your own pace — nothing to install.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto text-left">
        <div class="card">
          <div class="w-10 h-10 rounded-lg bg-brand-red-light flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-navy mb-2">Set up in about five minutes</h3>
          <p class="text-gray-600 text-sm">Add your students and lessons and you're ready to go — most instructors are up and running the same day.</p>
        </div>
        <div class="card">
          <div class="w-10 h-10 rounded-lg bg-brand-red-light flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-navy mb-2">Move at your own pace</h3>
          <p class="text-gray-600 text-sm">Keep your current diary running alongside until you're confident everything's in. No big switch-over day.</p>
        </div>
        <div class="card">
          <div class="w-10 h-10 rounded-lg bg-brand-red-light flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="font-bold text-brand-navy mb-2">Try it risk-free</h3>
