---
import { OFFER } from '../../config/offer';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbsEnhanced from '../../components/seo/BreadcrumbsEnhanced.astro';
import FAQEnhanced from '../../components/seo/FAQEnhanced.astro';
import ProductDemo from '../../components/ProductDemo.astro';

const faqs = [
  {
    question: "Who writes the briefing?",
    answer: "It is generated by Claude, Anthropic's AI, from your own lesson notes and the pupil's current DVSA skill ratings. It is not a template with names swapped in — it reads what you actually wrote last time.",
    links: []
  },
  {
    question: "Is my pupils' data used to train AI models?",
    answer: "No. Your data is sent securely to generate each briefing and is not used to train any AI model. Anthropic is listed as a sub-processor in our privacy policy.",
    links: [{ text: 'Privacy policy', url: '/privacy-policy/' }]
  },
  {
    question: "How long is a briefing?",
    answer: "Three or four sentences. It is deliberately short — it exists to be read in the ten seconds before you knock on the door, not to be a report. Anything longer would not get read.",
    links: []
  },
  {
    question: "What if the briefing is wrong?",
    answer: "It is a prompt, not an instruction. It summarises what you recorded, so if your notes were thin the briefing will be thin. You teach the lesson you think the pupil needs — the briefing is there so you start from what happened last time rather than from memory.",
    links: []
  },
  {
    question: "What if I don't write many notes?",
    answer: "The briefing can only work from what you give it, so sparse notes make a sparser briefing. The DVSA ratings do a lot of the lifting on their own, though — even with no written notes, it can see which competencies moved last time and which did not.",
    links: []
  },
  {
    question: "Does it work if another instructor took the last lesson?",
    answer: "That is where it earns its keep. The briefing draws on whatever was recorded, whoever recorded it, so a pupil handed between instructors does not have to explain their own history at the start of every lesson.",
    links: []
  }
];
---

<BaseLayout
  title="AI Lesson Briefings for Driving Instructors | DriveSchoolPro"
  description="Every lesson opens with a briefing already written — what you covered, what they struggled with, what to work on today. Three or four sentences, generated by Claude from your own notes. Free until 31 March 2027."
>
  <BreadcrumbsEnhanced items={[{ label: 'Home', href: '/' }, { label: 'Features', href: '/features/' }, { label: 'Lesson briefings' }]} site="driveschool" />

  <section class="section bg-white">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm uppercase tracking-wider text-gray-400 mb-3">The morning</p>
          <h1 class="text-4xl md:text-5xl font-bold text-brand-navy leading-tight mb-6">
            Know exactly what to teach before you pull up.
          </h1>
          <p class="text-xl text-gray-600 leading-relaxed">
            You have thirty pupils. You saw this one three weeks ago. You know there was something
            about roundabout lane discipline, or was that the other Maya? So you do what everyone
            does — you ask them how they got on last time, and take the first ten minutes of a
            paid hour working out where you are.
          </p>
        </div>
        <div>
          <ProductDemo
            poster="/images/marketing/ai-briefing-mobile.webp"
            posterAlt="DriveSchoolPro on a phone: the Today view showing a 15:00 lesson with a suggested focus of Manoeuvres and an AI lesson briefing on roundabout lane discipline."
            alt="A lesson card is opened and its AI briefing is already written: what was covered last time, what the pupil struggled with, and what to focus on today."
            width={640}
            height={1308}
            phone
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-gray-50 border-t border-gray-100">
    <div class="container-custom max-w-4xl space-y-14">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-4">Written from your notes, not from a template</h2>
        <p class="text-lg text-gray-600 mb-4">
          The briefing is generated by Claude from two things you already have: the notes you wrote
          after the last lesson, and the pupil's current ratings across the DVSA framework. That
          matters, because a template can only tell you what a lesson seven usually looks like. This
          tells you what happened to this pupil, in your car, three weeks ago.
        </p>
        <p class="text-lg text-gray-600">
          It reads like a note from a colleague who taught them last — because functionally, that is
          what it is standing in for.
        </p>
      </div>

      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-4">Four sentences. Ten seconds.</h2>
        <p class="text-lg text-gray-600">
          Length is a feature. A briefing you read in the ten seconds between parking and knocking
          gets read every time; a page of analysis gets read twice and then ignored. So it is capped
          at three or four sentences: what you covered, what they struggled with, what to focus on
          today. If you want the full picture it is one tap away in their progress record — but the
          briefing itself stays short enough to actually use.
        </p>
      </div>

      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-4">Your data stays yours</h2>
        <p class="text-lg text-gray-600">
          Your pupils' information is sent securely to generate each briefing and is never used to
          train any AI model. Anthropic is a named sub-processor in our privacy policy, alongside
          Stripe, Neon, Vercel and Resend.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-white border-t border-gray-100">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-bold text-brand-navy mb-8">How it works</h2>
      <ol class="space-y-6">
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-red text-white font-bold flex items-center justify-center">1</span>
          <div>
            <h3 class="font-bold text-brand-navy mb-1">Rate the lesson at the kerb</h3>
            <p class="text-gray-600">A couple of taps against the DVSA skills you worked on, plus a line of notes if you want. Thirty seconds while they are getting their bag.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-red text-white font-bold flex items-center justify-center">2</span>
          <div>
            <h3 class="font-bold text-brand-navy mb-1">The next briefing writes itself</h3>
            <p class="text-gray-600">Generated fresh for the next lesson, drawing on what you just recorded.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-red text-white font-bold flex items-center justify-center">3</span>
          <div>
            <h3 class="font-bold text-brand-navy mb-1">Read it on the way</h3>
            <p class="text-gray-600">It is on the lesson card in your Today view, so it is there when you arrive rather than somewhere you have to go looking.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <FAQEnhanced faqs={faqs} site="driveschool" pageUrl="https://driveschoolpro.com/features/lesson-briefings/" title="Questions about AI briefings" />

  <section class="section bg-brand-navy text-white">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Stop starting lessons from memory</h2>
      <p class="text-lg text-gray-300 mb-8">Free until 31 March 2027. No card, no contract, cancel any time.</p>
      <a href={OFFER.ctaPrimary.href} class="btn-primary text-lg px-8 py-4">{OFFER.ctaPrimary.label} &rarr;</a>
    </div>
  </section>

  <section class="section bg-white border-t border-gray-100">
    <div class="container-custom max-w-4xl">
      <h2 class="text-xl font-bold text-brand-navy mb-6">Related</h2>
      <ul class="space-y-3 text-lg">
        <li><a href="/features/progress-tracking/" class="text-brand-red font-semibold hover:underline">Progress tracking &rarr;</a> <span class="text-gray-500">— the ratings the briefing is written from</span></li>
        <li><a href="/features/scheduling/" class="text-brand-red font-semibold hover:underline">Scheduling &rarr;</a> <span class="text-gray-500">— where the lesson card lives</span></li>
        <li><a href="/how-progress-works/" class="text-brand-red font-semibold hover:underline">How progress tracking works &rarr;</a> <span class="text-gray-500">— the longer walkthrough</span></li>
      </ul>
    </div>
  </section>
</BaseLayout>
